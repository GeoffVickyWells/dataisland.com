---
// Languages offered by the Translate menu, each in its own name. Google Translate codes.
const languages = [
  ["fr", "Français"], ["es", "Español"], ["de", "Deutsch"], ["it", "Italiano"],
  ["pt", "Português"], ["nl", "Nederlands"], ["pl", "Polski"], ["tr", "Türkçe"],
  ["ru", "Русский"], ["ar", "العربية"], ["hi", "हिन्दी"], ["ja", "日本語"],
  ["ko", "한국어"], ["zh-CN", "简体中文"], ["zh-TW", "繁體中文"],
];
---

<header class="site-header">
  <div class="container">
    <a href="/" class="logo-link">
      <img src="/images/brand/palm.png" alt="DataIsland Logo" class="logo" />
      <span class="site-name" translate="no">DataIsland Software</span>
    </a>

    <nav class="nav">
      <a href="/">Home</a>
      <a href="/tutorials">Tutorials</a>
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>

    <details class="translate">
      <summary title="Read this page in another language with Google Translate">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
        </svg>
        <span>Translate</span>
      </summary>
      <ul class="translate-menu">
        {languages.map(([code, name]) => (
          <li><a href={`https://translate.google.com/?sl=en&tl=${code}&op=websites`} data-lang={code} lang={code} rel="nofollow">{name}</a></li>
        ))}
        <li class="translate-note">Translated by Google</li>
      </ul>
    </details>
  </div>
</header>

<script is:inline>
  // Point each language at Google Translate's copy of the page being read. Nothing is sent to
  // Google until a language is chosen.
  (function () {
    var page = location.href.split("#")[0];
    document.querySelectorAll(".translate-menu a[data-lang]").forEach(function (link) {
      link.href = "https://translate.google.com/translate?sl=en&tl=" + link.dataset.lang + "&u=" + encodeURIComponent(page);
    });
  })();
</script>

<style>
  .site-header {
    width: 100%;
    padding: 1rem 0;
    border-bottom: 1px solid var(--gray-light);
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .site-name {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--gray-dark);
  }

  .nav {
    margin-left: auto;
  }

  .nav a {
    margin-left: 1.5rem;
    font-size: 1rem;
    color: var(--gray-dark);
    transition: var(--transition);
  }

  .nav a:hover {
    color: var(--blue);
  }

  .translate {
    position: relative;
    margin-left: 1.5rem;
  }

  .translate summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    cursor: pointer;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--gray-light);
    border-radius: 999px;
    font-size: 0.95rem;
    color: var(--gray-dark);
    transition: var(--transition);
  }

  .translate summary::-webkit-details-marker { display: none; }

  .translate summary:hover,
  .translate[open] summary {
    color: var(--blue);
    border-color: var(--blue);
  }

  .translate-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 12rem;
    max-height: 70vh;
    overflow-y: auto;
    margin: 0;
    padding: 0.4rem 0;
    list-style: none;
    background: #fff;
    border: 1px solid var(--gray-light);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
  }

  .translate-menu a {
    display: block;
    padding: 0.45rem 1rem;
    color: var(--gray-dark);
    font-size: 0.95rem;
  }

  .translate-menu a:hover { background: var(--gray-light); color: var(--blue); }

  .translate-note {
    padding: 0.5rem 1rem 0.3rem;
    font-size: 0.78rem;
    color: var(--gray);
    border-top: 1px solid var(--gray-light);
    margin-top: 0.3rem;
  }

  @media (max-width: 768px) {
    .site-name {
      display: none;
    }

    .nav {
      display: none;
    }
  }
</style>
