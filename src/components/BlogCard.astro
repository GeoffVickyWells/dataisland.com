---
import BlogCover from "./BlogCover.astro";
import { topicInfo, readingMinutes, formatDate, type Post } from "../lib/blog";

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const topic = topicInfo(post.data.topics[0]);
---

<a href={`/blog/${post.id}`} class:list={["card", { featured }]}>
  <BlogCover post={post} size={featured ? "large" : "card"} />
  <div class="text">
    <span class="kicker" style={`color:${topic.ink}`}>{featured ? "Latest · " : ""}{topic.label}</span>
    {featured ? <h2>{post.data.title}</h2> : <h3>{post.data.title}</h3>}
    <p>{post.data.description}</p>
    <span class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      · {readingMinutes(post)} min read
      {post.data.draft && <strong class="draft">Draft</strong>}
    </span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: inherit;
    height: 100%;
  }
  .card:hover { opacity: 1; }
  .card:hover h2, .card:hover h3 { color: var(--blue); }
  .card :global(.cover) { transition: transform var(--transition), box-shadow var(--transition); }
  .card:hover :global(.cover) { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08); }

  .kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h2, h3 { margin: 0.35rem 0 0.5rem; color: #1a1a1a; transition: color var(--transition); }
  h3 { font-size: 1.2rem; line-height: 1.3; }
  h2 { font-size: 2rem; line-height: 1.15; }
  p { font-size: 0.95rem; line-height: 1.6; margin-bottom: 0.75rem; }
  .featured p { font-size: 1.05rem; }
  .meta { font-size: 0.82rem; color: var(--gray); }
  .draft {
    margin-left: 0.4rem;
    background: var(--yellow);
    color: #1a1a1a;
    font-size: 0.7rem;
    padding: 0.1em 0.5em;
    border-radius: 4px;
  }

  @media (min-width: 820px) {
    .featured {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 2.5rem;
      align-items: center;
    }
  }
</style>
