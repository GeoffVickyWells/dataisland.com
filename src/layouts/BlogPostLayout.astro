---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import BlogCover from "../components/BlogCover.astro";
import BlogCard from "../components/BlogCard.astro";
import { appStore } from "../data/products.js";
import { topicInfo, productInfo, readingMinutes, formatDate, type Post } from "../lib/blog";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  related: Post[];
}

const { post, headings, related } = Astro.props;
const { title, description, pubDate, updatedDate, author, topics, apps, cover } = post.data;
const mainTopic = topicInfo(topics[0]);
const appCards = apps.map(productInfo).filter((p) => p !== undefined);
const contents = headings.filter((h) => h.depth === 2);
const url = new URL(`/blog/${post.id}`, Astro.site);

// Structured data so search engines show the post as an article with its date and author.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { "@type": "Person", name: author },
  publisher: {
    "@type": "Organization",
    name: "DataIsland Software LLC",
    logo: { "@type": "ImageObject", url: new URL("/images/brand/palm.png", Astro.site).href },
  },
  mainEntityOfPage: url.href,
  image: new URL(cover ?? appCards[0]?.icon ?? "/images/brand/palm.png", Astro.site).href,
  keywords: topics.map((t) => topicInfo(t).label).join(", "),
};
---

<BaseLayout
  title={`${title} — DataIsland Blog`}
  description={description}
  image={cover ?? appCards[0]?.icon}
  ogType="article"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <meta slot="head" property="article:published_time" content={pubDate.toISOString()} />

  <article class="post">
    <header class="post-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/blog">Blog</a>
        <span aria-hidden="true">/</span>
        <a href={`/blog/topic/${topics[0]}`} style={`color:${mainTopic.ink}`}>{mainTopic.label}</a>
      </nav>
      <h1>{title}</h1>
      <p class="deck">{description}</p>
      <div class="byline">
        <img src="/images/brand/palm.png" alt="" class="avatar" />
        <span>
          <strong>{author}</strong>
          <span class="when">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
            · {readingMinutes(post)} min read
          </span>
        </span>
      </div>
    </header>

    <div class="post-cover">
      <BlogCover post={post} size="large" />
    </div>

    <div class="post-body">
      <div class="prose">
        <slot />
      </div>

      <aside class="side">
        {contents.length >= 3 && (
          <nav class="toc" aria-label="In this post">
            <p class="side-title">In this post</p>
            <ol>
              {contents.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </nav>
        )}
        <div class="side-topics">
          <p class="side-title">Topics</p>
          {topics.map((t) => {
            const info = topicInfo(t);
            return <a href={`/blog/topic/${t}`} class="chip" style={`--ink:${info.ink};--tint:${info.tint}`}>{info.label}</a>;
          })}
        </div>
      </aside>
    </div>

    {appCards.length > 0 && (
      <section class="apps">
        <p class="section-title">{appCards.length === 1 ? "The app in this post" : "The apps in this post"}</p>
        <div class="app-grid">
          {appCards.map((app) => {
            const listing = appStore[app.id];
            return (
              <div class="app-card">
                <img src={app.icon} alt="" class="app-icon" />
                <div>
                  <h3>{app.title}</h3>
                  <p>{app.description}</p>
                  <div class="app-links">
                    {listing && <a href={listing.url} class="btn-store">Get it on the Mac App Store</a>}
                    <a href={`/products/${app.id}`} class="btn-more">Learn more →</a>
                  </div>
                  {listing && <p class="price">{listing.price}</p>}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}
  </article>

  {related.length > 0 && (
    <section class="related">
      <p class="section-title">Keep reading</p>
      <div class="related-grid">
        {related.map((p) => <BlogCard post={p} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .post { max-width: 1100px; margin: 0 auto; }
  section { border-bottom: none; padding: 0; }

  .post-head {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.5rem 0 2rem;
    text-align: center;
  }
  .crumbs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .crumbs span { color: #ccc; }
  .post-head h1 {
    font-family: "New York", "Iowan Old Style", Georgia, serif;
    font-size: clamp(2rem, 5.5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.12;
    margin-bottom: 1rem;
  }
  .deck {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 1.75rem;
  }
  .byline {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-align: left;
  }
  .avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--sand);
    padding: 6px;
  }
  .byline strong { display: block; font-size: 0.95rem; }
  .when { font-size: 0.85rem; color: var(--gray); }

  .post-cover { margin: 0 auto 3rem; max-width: 1000px; }

  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (min-width: 960px) {
    .post-body { grid-template-columns: minmax(0, 680px) 240px; justify-content: space-between; }
    .side { position: sticky; top: 6rem; align-self: start; }
  }

  /* Article typography. Markdown output carries no scoping attributes, hence :global. */
  .prose { font-size: 1.12rem; line-height: 1.8; color: #262626; }
  .prose :global(p) { color: #262626; margin-bottom: 1.4rem; }
  .prose :global(h2) {
    font-family: "New York", "Iowan Old Style", Georgia, serif;
    font-size: 1.75rem;
    font-weight: 700;
    margin: 2.75rem 0 1rem;
    scroll-margin-top: 6rem;
  }
  .prose :global(h3) { font-size: 1.25rem; margin: 2rem 0 0.75rem; scroll-margin-top: 6rem; }
  .prose :global(> p:first-child::first-letter) {
    float: left;
    font-family: "New York", "Iowan Old Style", Georgia, serif;
    font-size: 3.6rem;
    line-height: 0.9;
    font-weight: 700;
    padding: 0.35rem 0.6rem 0 0;
    color: var(--blue);
  }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.4rem 1.4rem; }
  .prose :global(li) { margin-bottom: 0.5rem; }
  .prose :global(blockquote) {
    background: var(--blue-light);
    border-left: 4px solid var(--blue);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.1rem 1.4rem;
    margin: 2rem 0;
    font-size: 1.02rem;
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .prose :global(img) { max-width: 100%; border-radius: var(--radius); margin: 1rem 0; }
  .prose :global(kbd), .prose :global(code) {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.88em;
    background: var(--gray-light);
    border: 1px solid #e4e4e4;
    border-radius: 5px;
    padding: 0.1em 0.4em;
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0 2rem; font-size: 0.98rem; }
  .prose :global(th) { text-align: left; border-bottom: 2px solid #1a1a1a; padding: 0.5rem 0.75rem; }
  .prose :global(td) { border-bottom: 1px solid #eee; padding: 0.55rem 0.75rem; }
  .prose :global(hr) { border: none; border-top: 1px solid #eee; margin: 2.5rem 0; }

  .side-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: 0.6rem;
  }
  .toc { margin-bottom: 2rem; }
  .toc ol { list-style: none; border-left: 2px solid #eee; }
  .toc li { margin: 0; }
  .toc a {
    display: block;
    padding: 0.35rem 0 0.35rem 0.9rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--gray-dark);
  }
  .toc a:hover { border-left-color: var(--blue); color: var(--blue); opacity: 1; }
  .side-topics { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .side-topics .side-title { width: 100%; }
  .chip {
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    background: var(--tint);
    color: var(--ink);
  }

  .section-title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #eee;
    margin-bottom: 1.75rem;
  }

  .apps { max-width: 1000px; margin: 3.5rem auto 0; }
  .app-grid { display: grid; gap: 1.25rem; }
  .app-card {
    display: flex;
    gap: 1.25rem;
    background: var(--sand);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .app-icon { width: 76px; height: 76px; border-radius: 18px; flex-shrink: 0; }
  .app-card h3 { margin-bottom: 0.35rem; font-size: 1.25rem; }
  .app-card p { font-size: 0.95rem; line-height: 1.6; margin-bottom: 1rem; }
  .app-links { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .btn-store {
    background: #1a1a1a;
    color: #fff;
    padding: 0.6rem 1.1rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .btn-more { font-weight: 600; font-size: 0.92rem; }
  .app-card .price { font-size: 0.82rem; color: var(--gray); margin: 0.6rem 0 0; }

  .related { max-width: 1000px; margin: 4rem auto 2rem; }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 600px) {
    .prose { font-size: 1.05rem; }
    .deck { font-size: 1.08rem; }
    .app-card { flex-direction: column; padding: 1.25rem; }
    .app-icon { width: 60px; height: 60px; }
  }
</style>
