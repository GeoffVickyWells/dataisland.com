---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "DataIsland Software", description = "Privacy‑first tools for creators and professionals." } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/images/brand/palm.png" />
    <link rel="apple-touch-icon" href="/images/brand/palm.png" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      function check() {
        document.querySelectorAll(".fade-in:not(.go)").forEach(function (el) {
          var rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.90) {
            el.classList.add("go");
          }
        });
      }

      // A section already within the 90%-viewport line on the very first
      // check (DOMContentLoaded fires before the browser's first paint)
      // gets its "go" class added before the "opacity:0 / translated" start
      // state ever renders — the transition has nothing to animate from, so
      // it just appears in its final position with no reveal at all. Two
      // rAFs guarantee a real paint of the start state first, so sections
      // near the top of the page (the ones most likely to be in view on
      // load) get the same visible reveal as everything below the fold.
      function initialCheck() {
        requestAnimationFrame(function () {
          requestAnimationFrame(check);
        });
      }

      window.addEventListener("scroll", check, { passive: true });
      window.addEventListener("load", initialCheck);
      document.addEventListener("DOMContentLoaded", initialCheck);
      document.addEventListener("mousemove", check, { once: true, passive: true });
    </script>
    <script type="text/javascript" src="https://cdn.ywxi.net/js/1.js" async></script>
  </body>
</html>
