---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import AppFAQ from "../../components/AppFAQ.astro";
import AppStoreCTA from "../../components/AppStoreCTA.astro";

const icon = "/images/products/comingsoon/icon1.png";

const apps = [
  {
    id: "polyscript",
    step: "01",
    title: "PolyScript",
    tagline: "Write the screenplay. Fountain, from the ground up.",
    description: "A native Fountain screenplay editor with real page counts, character autocomplete, an AI writing tab, and on-device translation.",
    price: "$34.99",
  },
  {
    id: "tableread",
    step: "02",
    title: "TableRead",
    tagline: "Hear your script before anyone else does.",
    description: "Cast every character with a voice from your library and generate a full AI read-through — entirely on-device.",
    price: "$34.99",
  },
  {
    id: "talent",
    step: "03",
    title: "Talent",
    tagline: "Your voice library. Every voice you've built or borrowed.",
    description: "Train custom AI voices from a recording, or import existing RVC models. Consent tracking and a resume for every voice.",
    price: "$54.99",
  },
  {
    id: "studio",
    step: "04",
    title: "Studio",
    tagline: "Where the performance becomes the finished track.",
    description: "Record or import a performance, convert it through any voice in your library, and export the finished track.",
    price: "$44.99",
  },
  {
    id: "polyproject",
    step: "05",
    title: "PolyProject",
    tagline: "The whole production, tracked in one place.",
    description: "A four-stage tracker that stays in sync automatically as the other apps finish their work. Included free with the bundle.",
    price: "$19.99 value",
    included: true,
  },
];
---

<BaseLayout
  title="PolySpeak — The Complete AI Voice Production Suite for Mac"
  description="PolySpeak is five connected Mac apps — PolyScript, TableRead, Talent, Studio, and PolyProject — for writing, casting, training voices, and capturing performances. $129 for the whole suite, a $61 savings over buying separately."
>

  <!-- Hero -->
  <section class="product-hero fade-in">
    <img src={icon} alt="PolySpeak" class="product-icon" />
    <h1>PolySpeak</h1>
    <p class="tagline">Real performances, carried by AI voices.</p>
    <p class="hero-sub">
      PolySpeak doesn't just read your script aloud — it captures how someone actually performs
      it, and carries that performance through an AI voice. Five connected Mac apps covering an
      entire production pipeline, from a blank screenplay to a finished, cast performance. Every
      app is genuinely useful on its own; together, they're a complete studio.
    </p>
    <div class="hero-meta">macOS 14 Sonoma or later &nbsp;·&nbsp; 14-day free trial per app &nbsp;·&nbsp; $129 one-time, all 5 apps</div>
    <AppStoreCTA />
  </section>

  <!-- Performance capture -- the core differentiator, front and center -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">🎬</div>
    <div class="feature-body">
      <h2>This is performance capture, not text-to-speech.</h2>
      <p>
        Most AI voice tools generate a flat, mechanical reading — text goes in, a voice reads
        it back, with no real timing or emotion behind it. PolySpeak works differently: a real
        person performs the lines — the pacing, the pauses, the emotion, the choices only a
        human performer makes — and Studio carries that performance through the cast AI voice.
        The voice changes. The performance doesn't.
      </p>
      <p>
        It's the same principle motion capture uses in film. An actor covered in tracking
        markers delivers a real physical performance, and that performance drives the CG
        character — the studio doesn't animate a generic walk cycle and hope it reads as
        human. PolySpeak applies the same idea to voice: capture the real thing, then carry
        it through whatever voice the role needs.
      </p>
      <div class="callout">
        TableRead's AI read-through is a fast, flat check — cast a script and hear it read
        back to validate casting choices before anyone performs anything. <strong>Studio is
        where the actual performance happens.</strong> That distinction is the reason
        PolySpeak exists as five connected apps instead of one AI voice generator.
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="pipeline-section fade-in">
    <h2>One connected workflow, five apps.</h2>
    <p class="pipeline-intro">
      Standard file formats hold the whole suite together — Fountain screenplays, RVC voice
      models, plain WAV audio. Nothing is locked to a proprietary format, and no app assumes
      another one's output exists.
    </p>
    <div class="pipeline-grid">
      {apps.map((app) => (
        <a href={`/products/${app.id}`} class={`pipeline-card ${app.included ? "included" : ""}`}>
          <div class="pipeline-step">STEP {app.step}</div>
          <h3>{app.title}</h3>
          <p class="pipeline-tagline">{app.tagline}</p>
          <p class="pipeline-desc">{app.description}</p>
          <div class="pipeline-price">
            {app.price}
            {app.included && <span class="included-badge">Included</span>}
          </div>
          <span class="pipeline-link">Learn more →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Pricing comparison -->
  <section class="pricing-section fade-in">
    <h2>Five apps. One price. A real discount.</h2>
    <div class="price-compare-cards">
      <div class="price-compare-card">
        <h3>Buy separately</h3>
        <ul class="compare-list">
          <li><span>PolyScript</span><span>$34.99</span></li>
          <li><span>TableRead</span><span>$34.99</span></li>
          <li><span>Talent</span><span>$54.99</span></li>
          <li><span>Studio</span><span>$44.99</span></li>
          <li><span>PolyProject</span><span>$19.99 value, not sold alone</span></li>
        </ul>
        <div class="compare-total">
          <span>Combined value</span>
          <span>$189.95</span>
        </div>
      </div>
      <div class="price-compare-card featured">
        <h3>The PolySpeak bundle</h3>
        <div class="bundle-price">$129</div>
        <div class="bundle-price-detail">one-time purchase · no subscription</div>
        <ul>
          <li>All 5 apps, including PolyProject free</li>
          <li>Buy once · yours forever</li>
          <li>Free updates to every app</li>
          <li>macOS 14 Sonoma or later</li>
        </ul>
        <div class="savings-badge">Save $61 · 32% off</div>
      </div>
    </div>
  </section>

  <!-- Standalone value -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">🧩</div>
    <div class="feature-body">
      <h2>The bundle is a deal, not a requirement.</h2>
      <p>
        Every one of PolyScript, TableRead, Talent, and Studio is a complete, standalone app —
        buy just the one you need and it works fully on its own. PolySpeak's apps talk to each
        other through plain, standard files (.fountain, .pth, .wav), not a proprietary format
        that locks you into the whole suite. The bundle exists for people who want the entire
        pipeline and a real discount for buying it all at once — not because any single app is
        held back without the others.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <AppFAQ heading="PolySpeak bundle — frequently asked questions" items={[
    {
      question: "Can I just buy one app instead of the whole bundle?",
      answer: "Yes. PolyScript, TableRead, Talent, and Studio are each sold individually and are fully standalone — none of them require the others to work. PolyProject is the one exception: it's included free with the bundle and isn't sold separately, since its whole purpose is coordinating the other four."
    },
    {
      question: "I already own one of the four apps — can I upgrade to the bundle?",
      answer: "Reach out to support@dataisland.com once the bundle is live and we'll sort out a fair upgrade path so you're not paying twice for an app you already own."
    },
    {
      question: "Is PolyProject really not available on its own?",
      answer: "Correct. PolyProject tracks progress across Script, Casting, Table Read, and Performance Capture — stages that only exist once you're using the other four apps. Selling it alone would mean selling an empty dashboard, so it ships free with the bundle instead."
    },
    {
      question: "Do the apps require each other to work?",
      answer: "No. Each app reads and writes standard, open file formats — Fountain for scripts, RVC's native .pth/.index for voice models, plain WAV/AIFF/M4A for audio. A screenwriter can use PolyScript alone with no other PolySpeak app installed; the same is true for TableRead, Talent, and Studio."
    },
    {
      question: "Does any part of the PolySpeak pipeline send my content to the cloud?",
      answer: "Voice training, voice conversion, and AI read-through generation all run entirely on-device through a local pipeline — no audio, no voice model, no script content is ever uploaded. PolyScript's optional AI writing tab is the one exception, and even that only sends content off-device if you explicitly choose the OpenRouter option over on-device Apple Intelligence."
    },
    {
      question: "What's the free trial for the bundle?",
      answer: "Each app carries its own 14-day free trial with full functionality, no credit card required. Try the whole pipeline before deciding."
    }
  ]} />

  <!-- Waitlist -->
  <section class="waitlist-section fade-in">
    <EmailCapture app="PolySpeak" label="Get 10% off the PolySpeak bundle at launch" />
    <p class="privacy-note">
      By joining you agree to our <a href="/terms">Terms of Use</a>.
      Privacy policies for each app are linked from its own product page.
    </p>
  </section>

</BaseLayout>

<style>
  .product-hero {
    text-align: center;
    padding: 4rem 0 3rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .product-icon {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    margin-bottom: 1.5rem;
  }

  .product-hero h1 { font-size: 2.75rem; margin-bottom: 0.5rem; }

  .tagline {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--gray-dark);
    margin-bottom: 1.5rem;
  }

  .hero-meta { font-size: 0.9rem; color: var(--gray); }

  /* Pipeline */
  .pipeline-section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3.5rem 1rem;
    text-align: center;
    border-bottom: 1px solid var(--gray-light);
  }

  .pipeline-section h2 { font-size: 1.75rem; margin-bottom: 0.75rem; }

  .pipeline-intro {
    max-width: 640px;
    margin: 0 auto 2.5rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--gray-dark);
  }

  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  .pipeline-card {
    display: flex;
    flex-direction: column;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.5rem 1.25rem;
    text-align: left;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition: var(--transition);
  }

  .pipeline-card:hover {
    border-color: var(--blue);
    opacity: 1;
  }

  .pipeline-card.included {
    background: var(--blue-light);
  }

  .pipeline-step {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--blue);
    margin-bottom: 0.5rem;
  }

  .pipeline-card h3 { font-size: 1.05rem; margin-bottom: 0.35rem; }

  .pipeline-tagline {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .pipeline-desc {
    font-size: 0.85rem;
    color: var(--gray-dark);
    line-height: 1.5;
    margin-bottom: 0.85rem;
    flex: 1;
  }

  .pipeline-price {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .included-badge {
    display: inline-block;
    background: var(--blue);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2em 0.6em;
    border-radius: 999px;
  }

  .pipeline-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--blue);
  }

  /* Pricing comparison */
  .pricing-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 3.5rem 1rem;
    text-align: center;
    border-bottom: 1px solid var(--gray-light);
  }

  .pricing-section h2 { font-size: 1.75rem; margin-bottom: 2.5rem; }

  .price-compare-cards {
    display: flex;
    gap: 1.5rem;
    align-items: stretch;
  }

  .price-compare-card {
    flex: 1;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: left;
  }

  .price-compare-card h3 { font-size: 1.1rem; margin-bottom: 1.25rem; }

  .compare-list { list-style: none; padding: 0; margin: 0 0 1.25rem; }

  .compare-list li {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    color: var(--gray-dark);
  }

  .compare-total {
    display: flex;
    justify-content: space-between;
    font-size: 1.05rem;
    font-weight: 700;
    padding-top: 0.75rem;
  }

  .price-compare-card.featured {
    background: var(--blue);
    color: #fff;
  }

  .price-compare-card.featured h3 { color: rgba(255,255,255,0.85); }

  .bundle-price { font-size: 2.5rem; font-weight: 700; margin-bottom: 0.25rem; }

  .bundle-price-detail {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.75);
    margin-bottom: 1.25rem;
  }

  .price-compare-card.featured ul { list-style: none; padding: 0; margin: 0 0 1.25rem; }

  .price-compare-card.featured ul li {
    font-size: 0.92rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.92);
  }

  .price-compare-card.featured ul li::before { content: "✓  "; }

  .savings-badge {
    display: inline-block;
    background: #fff;
    color: var(--blue);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.4em 0.9em;
    border-radius: 999px;
  }

  /* Standalone value feature section (reused classes) */
  .feature-section {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
    max-width: 900px;
    margin: 0 auto;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--gray-light);
  }

  .feature-section.alt {
    background: var(--gray-light);
    padding: 3.5rem 1.5rem;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    border-bottom: none;
    justify-content: center;
  }

  .feature-section.alt > * { max-width: 560px; }

  .feature-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
    width: 56px;
    text-align: center;
    padding-top: 0.25rem;
  }

  .feature-body { flex: 1; max-width: 820px; }
  .feature-body h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  .feature-body p { font-size: 1.05rem; line-height: 1.7; margin-bottom: 1rem; }

  .callout {
    background: var(--blue-light);
    border-left: 4px solid var(--blue);
    border-radius: 0 10px 10px 0;
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
    color: var(--gray-dark);
    margin-top: 1rem;
  }

  /* Waitlist */
  .waitlist-section { padding: 1rem 0 3rem; border-bottom: none; }

  .privacy-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--gray);
    margin-top: -1.5rem;
  }

  .privacy-note a { color: var(--gray-dark); text-decoration: underline; }
  .privacy-note a:hover { color: var(--blue); }

  @media (max-width: 900px) {
    .pipeline-grid { grid-template-columns: repeat(2, 1fr); }
    .price-compare-cards { flex-direction: column; }
  }

  @media (max-width: 768px) {
    .pipeline-grid { grid-template-columns: 1fr; }

    .feature-section,
    .feature-section.alt {
      flex-direction: column;
      gap: 1.25rem;
      padding: 2.5rem 1rem;
      margin-left: 0;
      margin-right: 0;
      width: 100%;
      left: 0;
      right: 0;
    }
  }
</style>
