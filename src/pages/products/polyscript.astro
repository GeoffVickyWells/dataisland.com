---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppFAQ from "../../components/AppFAQ.astro";
import AppStoreCTA from "../../components/AppStoreCTA.astro";

const icon = "/images/products/comingsoon/icon1.png";
---

<BaseLayout
  title="PolyScript — Fountain Screenwriting for Mac"
  description="PolyScript is a native Mac screenplay editor built on the Fountain format. Autocomplete, a format-teaching toolbar, AI screenplay tools, and on-device translation. $34.99, one-time purchase, or get all 5 PolySpeak apps for $129."
>

  <!-- Hero -->
  <section class="product-hero fade-in">
    <img src={icon} alt="PolyScript" class="product-icon" />
    <h1>PolyScript</h1>
    <p class="tagline">Write the screenplay. Fountain, from the ground up.</p>
    <p class="hero-sub">
      A native Mac screenplay editor built on Fountain — the real screenwriting-industry
      standard, compatible with Final Draft, Highland, WriterDuet, and Slugline. Correct
      Courier 12pt formatting, character and location autocomplete, and AI tools built
      specifically for scripts, not prose.
    </p>
    <div class="hero-meta">macOS 14 Sonoma or later &nbsp;·&nbsp; 14-day free trial &nbsp;·&nbsp; $34.99 one-time purchase</div>
    <AppStoreCTA />
  </section>

  <!-- First app in the pipeline -->
  <section class="three-levels fade-in">
    <div class="level">
      <div class="level-num">STEP 1</div>
      <h3>Write</h3>
      <p>PolyScript is where every PolySpeak production starts — a proper Fountain screenplay, saved as a plain-text .fountain file that any of the other four apps can open.</p>
    </div>
    <div class="level">
      <div class="level-num">STANDARD</div>
      <h3>Real Fountain</h3>
      <p>Fountain is a plain-text screenwriting format already used across the industry. PolyScript reads and writes it natively — no lock-in, no proprietary format.</p>
    </div>
    <div class="level">
      <div class="level-num">NEXT UP</div>
      <h3>Cast It</h3>
      <p>Open your finished .fountain file in TableRead to assign a voice to every character and hear an AI read-through before anyone sets foot in a booth.</p>
    </div>
  </section>

  <!-- Feature: Fountain format -->
  <section class="feature-section fade-in">
    <div class="feature-icon">🎬</div>
    <div class="feature-body">
      <h2>The format the industry actually uses.</h2>
      <p>
        Fountain is plain text that renders as a correctly formatted screenplay — no
        proprietary file format, no lock-in. PolyScript writes clean Fountain that opens
        in Final Draft, Highland, WriterDuet, and Slugline, all set in Courier 12pt.
      </p>
      <div class="mini-feature-grid">
        <div class="mini-feature">
          <h3>Character &amp; Location Autocomplete</h3>
          <p>Start typing a character name or scene location you've already used, and PolyScript finishes it for you — consistent names and slug lines without a lookup.</p>
        </div>
        <div class="mini-feature">
          <h3>Dual Dialogue</h3>
          <p>Full support for Fountain's <code>^</code> marker, laying out two characters speaking at the same time side by side, exactly as the format intends.</p>
        </div>
        <div class="mini-feature">
          <h3>Title Page Editor</h3>
          <p>A dedicated editor for Title, Credit, Author, Draft Date, Contact, and Language — the metadata every produced script needs on page one.</p>
        </div>
        <div class="mini-feature">
          <h3>Real Page Count &amp; Runtime</h3>
          <p>Page count and runtime are measured from your actual laid-out text — not a line-count guess — using the industry convention of one page per minute.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature: Format toolbar -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">🧰</div>
    <div class="feature-body">
      <h2>A toolbar that teaches the format as you write.</h2>
      <p>
        One click inserts a correctly formatted screenplay element. Every button's tooltip
        explains the convention behind it — useful whether you've written forty scripts or none.
      </p>
      <ul class="feature-list">
        <li><strong>Scene Heading</strong> — INT./EXT., location, and time of day, formatted automatically</li>
        <li><strong>Action</strong> — present-tense description, left-aligned to the standard margin</li>
        <li><strong>Character</strong> — capitalized and centered above their dialogue</li>
        <li><strong>Dialogue</strong> — indented under the character cue</li>
        <li><strong>Parenthetical</strong> — a brief direction tucked inside dialogue</li>
        <li><strong>Transition</strong> — CUT TO:, right-aligned per convention</li>
        <li><strong>Title Page, Section, Synopsis, Lyric, Note</strong> — every supporting Fountain element, one click away</li>
      </ul>
      <div class="callout">
        New to screenplay format? PolyScript opens with a short annotated starter template
        demonstrating every element in context. Turn it off in Settings once you don't need it.
      </div>
    </div>
  </section>

  <!-- Feature: AI tab -->
  <section class="feature-section fade-in">
    <div class="feature-icon">🧠</div>
    <div class="feature-body">
      <h2>AI tools built for scripts, not prose.</h2>
      <p>
        The AI tab understands screenplay structure — it works on scenes, characters, and
        dialogue, not generic paragraphs.
      </p>
      <ul class="feature-list">
        <li><strong>Continue</strong> — extend the current scene in the voice already established</li>
        <li><strong>Punch Up Dialogue</strong> — sharpen a selected exchange without changing its meaning</li>
        <li><strong>Voice Check</strong> — flags when two characters' dialogue reads too similarly in vocabulary and rhythm, worth knowing before you cast two different AI voices onto characters who read identically on the page</li>
        <li><strong>Fix Format</strong> — corrects Fountain formatting mistakes in a selection</li>
        <li><strong>Proofread</strong> — catches spelling, grammar, and continuity slips</li>
        <li><strong>Summarize Scene</strong> — a quick synopsis for a beat sheet or a table read note</li>
      </ul>
      <ul class="feature-list">
        <li><strong>Apple Intelligence</strong> — on-device, completely private. Requires Apple Silicon + macOS 26 + Apple Intelligence enabled.</li>
        <li><strong>OpenRouter</strong> — cloud-based with your own API key, for any Mac.</li>
        <li><strong>Neither</strong> — PolyScript is a fully functional screenwriting tool without any AI configured.</li>
      </ul>
    </div>
  </section>

  <!-- Feature: Translation -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">🌍</div>
    <div class="feature-body">
      <h2>Translate the whole script — or just a scene.</h2>
      <p>
        The translation panel uses Apple's on-device Translation framework — around 40
        languages, entirely on-device, no API key. Translate the entire screenplay to a new
        file, or translate just a selection in place.
      </p>
      <div class="rtl-callout">
        <strong>Right-to-left languages fully supported</strong>
        <p>Arabic · Hebrew · Persian, alongside roughly 40 languages total</p>
      </div>
    </div>
  </section>

  <!-- Feature: What else -->
  <section class="feature-section fade-in">
    <div class="feature-icon">⚡</div>
    <div class="feature-body">
      <h2>The rest of what a screenwriting app should have.</h2>
      <div class="mini-feature-grid">
        <div class="mini-feature">
          <h3>Multi-Window</h3>
          <p>Work on more than one script at a time, each in its own window.</p>
        </div>
        <div class="mini-feature">
          <h3>Print</h3>
          <p>Print a properly paginated screenplay directly from the toolbar.</p>
        </div>
        <div class="mini-feature">
          <h3>Spell &amp; Grammar Check</h3>
          <p>Continuous checking built into the editor, the same engine macOS uses system-wide.</p>
        </div>
        <div class="mini-feature">
          <h3>Full Undo</h3>
          <p>Every edit, every AI action, every format change — fully reversible.</p>
        </div>
        <div class="mini-feature">
          <h3>Finder File Association</h3>
          <p>Double-click any .fountain file in Finder and it opens directly in PolyScript.</p>
        </div>
        <div class="mini-feature">
          <h3>Open Anywhere</h3>
          <p>Every script you write is a plain .fountain file — open it in TableRead, or in any other Fountain-compatible screenwriting app.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section fade-in">
    <h2>Simple, honest pricing.</h2>
    <div class="pricing-cards">
      <div class="pricing-card">
        <h3>Free Trial</h3>
        <div class="price">14 days</div>
        <div class="price-detail">no credit card required</div>
        <ul>
          <li>Full editor — no feature limits</li>
          <li>Fountain read &amp; write</li>
          <li>Format-teaching toolbar</li>
          <li>Character &amp; location autocomplete</li>
          <li>AI tab (Apple Intelligence or OpenRouter)</li>
          <li>Translation panel (~40 languages)</li>
          <li>Title Page editor, dual dialogue</li>
          <li>Print, spell &amp; grammar check</li>
        </ul>
      </div>
      <div class="pricing-card featured">
        <h3>PolyScript</h3>
        <div class="price">$34.99</div>
        <div class="price-detail">one-time purchase · no subscription</div>
        <ul>
          <li>Everything in the trial</li>
          <li>Buy once · yours forever</li>
          <li>Free updates</li>
          <li>macOS 14 Sonoma or later</li>
        </ul>
      </div>
    </div>
    <p class="pricing-compare">
      Already planning to cast and produce the script? Get PolyScript and 4 more apps
      in the <a href="/products/polyspeak">PolySpeak bundle</a> for $129 — save $61
      versus buying separately.
    </p>
  </section>

  <!-- FAQ -->
  <AppFAQ items={[
    {
      question: "What is Fountain, and why does PolyScript use it?",
      answer: "Fountain is a plain-text screenwriting format that renders as a correctly formatted screenplay — it's the real industry standard behind apps like Final Draft, Highland, WriterDuet, and Slugline. PolyScript writes clean Fountain, set in Courier 12pt, so your script opens correctly in any of those tools, and nowhere is your work locked into a proprietary format."
    },
    {
      question: "Do I need Final Draft or another screenwriting app too?",
      answer: "No. PolyScript is a complete Fountain editor on its own — scene headings, dialogue, dual dialogue, title pages, autocomplete, page count, and print are all built in. Because it saves standard .fountain files, you can also open your script in Final Draft, Highland, or any other Fountain-compatible app if you ever need to."
    },
    {
      question: "What does Voice Check do?",
      answer: "Voice Check is an AI action that flags when two characters' dialogue reads too similarly in vocabulary and rhythm. It's especially useful before casting in TableRead or Talent — if two characters already sound alike on the page, they'll sound even more alike once the same or similar AI voices are cast onto them."
    },
    {
      question: "Do I need Apple Intelligence to use the AI tab?",
      answer: "No. Apple Intelligence gives you on-device, completely private AI actions, but it requires Apple Silicon, macOS 26, and Apple Intelligence enabled. If that's not available, you can connect OpenRouter with your own API key instead, or skip AI entirely — the editor, autocomplete, format toolbar, and translation panel all work without it."
    },
    {
      question: "Can I use PolyScript on its own, without the rest of PolySpeak?",
      answer: "Yes. PolyScript is a genuinely standalone screenwriting app — the .fountain file it saves is the interchange format, so TableRead, Studio, and any other Fountain-compatible app can open your script without PolyScript needing to be installed. The PolySpeak bundle is for convenience and savings, not because PolyScript is limited alone."
    },
    {
      question: "Is PolyScript included in the PolySpeak bundle?",
      answer: "Yes. The PolySpeak bundle includes PolyScript, TableRead, Talent, Studio, and PolyProject for $129 one-time — a savings of $61 versus the $189.95 combined individual price. See the full breakdown on the PolySpeak bundle page."
    }
  ]} />

</BaseLayout>

<style>
  .product-hero {
    text-align: center;
    padding: 4rem 0 3rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .product-icon {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    margin-bottom: 1.5rem;
  }

  .product-hero h1 { font-size: 2.75rem; margin-bottom: 0.5rem; }

  .tagline {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--gray-dark);
    margin-bottom: 1.5rem;
  }

  .hero-meta { font-size: 0.9rem; color: var(--gray); }

  /* Three-level callouts */
  .three-levels {
    display: flex;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--gray-light);
  }

  .level {
    flex: 1;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .level-num {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--blue);
    margin-bottom: 0.5rem;
  }

  .level h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }

  .level p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--gray-dark);
    margin: 0;
  }

  /* Feature sections */
  .feature-section {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
    max-width: 900px;
    margin: 0 auto;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--gray-light);
  }

  .feature-section.alt {
    background: var(--gray-light);
    padding: 3.5rem 1.5rem;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    border-bottom: none;
    justify-content: center;
  }

  .feature-section.alt > * { max-width: 420px; }

  .feature-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
    width: 56px;
    text-align: center;
    padding-top: 0.25rem;
  }

  .feature-body { flex: 1; max-width: 820px; }
  .feature-body h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  .feature-body p { font-size: 1.05rem; line-height: 1.7; margin-bottom: 1rem; }

  .callout {
    background: var(--blue-light);
    border-left: 4px solid var(--blue);
    border-radius: 0 10px 10px 0;
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
    color: var(--gray-dark);
    margin-top: 1rem;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .feature-list li {
    padding: 0.65rem 0;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    color: var(--gray-dark);
    border-bottom: 1px solid var(--gray-light);
    position: relative;
    line-height: 1.5;
  }

  .feature-list li::before { content: "→"; position: absolute; left: 0; color: var(--blue); }

  .mini-feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .mini-feature {
    background: #fff;
    border-radius: 10px;
    padding: 1rem 1.25rem;
  }

  .mini-feature h3 { font-size: 0.9rem; font-weight: 600; color: var(--blue); margin-bottom: 0.35rem; }
  .mini-feature p  { font-size: 0.88rem; margin: 0; color: var(--gray-dark); }

  /* RTL callout */
  .rtl-callout {
    background: #e8f0fe;
    border-left: 4px solid #4a80f0;
    border-radius: 0 10px 10px 0;
    padding: 1rem 1.25rem;
    margin: 1.25rem 0;
  }

  .rtl-callout strong { display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: #1a3a7a; }
  .rtl-callout p { font-size: 0.88rem !important; color: var(--gray-dark) !important; margin: 0 !important; }

  /* Pricing */
  .pricing-section {
    max-width: 760px;
    margin: 0 auto;
    padding: 3.5rem 0;
    text-align: center;
    border-bottom: none;
  }

  .pricing-section h2 { font-size: 1.6rem; margin-bottom: 2rem; }

  .pricing-cards { display: flex; gap: 1.5rem; justify-content: center; }

  .pricing-card {
    flex: 1;
    max-width: 320px;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.75rem;
    text-align: left;
  }

  .pricing-card.featured { background: var(--blue); color: #fff; }
  .pricing-card h3 { font-size: 1rem; margin-bottom: 0.75rem; }
  .pricing-card.featured h3 { color: rgba(255,255,255,0.8); }

  .price { font-size: 2rem; font-weight: 700; margin-bottom: 0.25rem; }

  .price-detail {
    font-size: 0.8rem;
    opacity: 0.75;
    margin-bottom: 1rem;
    color: var(--gray-dark);
  }

  .pricing-card.featured .price-detail { color: rgba(255,255,255,0.7); }

  .pricing-card ul { list-style: none; padding: 0; margin-top: 1rem; }

  .pricing-card ul li {
    font-size: 0.9rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    color: var(--gray-dark);
  }

  .pricing-card.featured ul li {
    border-color: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.9);
  }

  .pricing-card ul li::before { content: "✓  "; }

  .pricing-compare {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--gray);
  }

  .pricing-compare a { color: var(--blue); text-decoration: underline; }

  /* Waitlist */
  .waitlist-section { padding: 1rem 0 3rem; border-bottom: none; }

  .privacy-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--gray);
    margin-top: -1.5rem;
  }

  .privacy-note a { color: var(--gray-dark); text-decoration: underline; }
  .privacy-note a:hover { color: var(--blue); }

  @media (max-width: 768px) {
    .three-levels { flex-direction: column; }

    .feature-section,
    .feature-section.alt {
      flex-direction: column;
      gap: 1.25rem;
      padding: 2.5rem 1rem;
      margin-left: 0;
      margin-right: 0;
      width: 100%;
      left: 0;
      right: 0;
    }

    .mini-feature-grid { grid-template-columns: 1fr; }
    .pricing-cards { flex-direction: column; align-items: stretch; }
    .pricing-card { max-width: 100%; }
  }
</style>
