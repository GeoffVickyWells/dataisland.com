---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import AppFAQ from "../../components/AppFAQ.astro";
import AppStoreCTA from "../../components/AppStoreCTA.astro";

const icon = "/images/products/comingsoon/icon1.png";
---

<BaseLayout
  title="Studio — Performance Capture & Voice Conversion for Mac"
  description="Studio records and stitches real performances, then converts any take through any voice in your library. Multi-segment recording, session persistence, and export to WAV, AIFF, or M4A. $44.99, one-time purchase, or get all 5 PolySpeak apps for $129."
>

  <!-- Hero -->
  <section class="product-hero fade-in">
    <img src={icon} alt="Studio" class="product-icon" />
    <h1>Studio</h1>
    <p class="tagline">Where the performance becomes the finished track.</p>
    <p class="hero-sub">
      Import a recording or record live, right in the app. Stop, redo any part that
      didn't land, reorder the keepers, and stitch them into one continuous take — then
      convert it through any voice in your library and export a finished track.
    </p>
    <div class="hero-meta">macOS 14 Sonoma or later &nbsp;·&nbsp; 14-day free trial &nbsp;·&nbsp; $44.99 one-time purchase</div>
    <AppStoreCTA />
  </section>

  <!-- Pipeline position -->
  <section class="three-levels fade-in">
    <div class="level">
      <div class="level-num">STEP 4</div>
      <h3>Perform</h3>
      <p>Studio is where a real performance is captured and converted into the finished character track.</p>
    </div>
    <div class="level">
      <div class="level-num">INPUT</div>
      <h3>Any Recording</h3>
      <p>Import existing audio, or record live directly in Studio — no other PolySpeak app required to start.</p>
    </div>
    <div class="level">
      <div class="level-num">OUTPUT</div>
      <h3>A Finished Track</h3>
      <p>Export to WAV, AIFF, or M4A — ready to hand off to PolyProject for production tracking, or anywhere else you need it.</p>
    </div>
  </section>

  <!-- Feature: Performance capture, the core concept -->
  <section class="feature-section fade-in">
    <div class="feature-icon">🎬</div>
    <div class="feature-body">
      <h2>Performance capture, not text-to-speech.</h2>
      <p>
        TableRead's read-through is a fast, flat check — a script gets read back in the cast
        voices so you can validate casting before anyone performs anything. Studio is where a
        real performance happens: a person delivers the lines with real timing and emotion,
        and Studio carries that performance through the cast AI voice. The same principle
        motion capture uses in film — an actor's real performance drives the character, not a
        generic animation — applied to voice instead of movement.
      </p>
    </div>
  </section>

  <!-- Feature: Recording & takes -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">🎙️</div>
    <div class="feature-body">
      <h2>Real performances rarely happen in one unbroken take.</h2>
      <p>
        Import an existing recording, or record live directly in the app. Multi-segment
        recording lets you stop, redo any part that didn't land, reorder the keepers, and
        stitch them into one continuous take — built for the reality that a non-actor won't
        nail an emotional performance in one perfect run.
      </p>
      <ul class="feature-list">
        <li><strong>Import</strong> — bring in an existing recording from anywhere on your Mac</li>
        <li><strong>Record Live</strong> — capture directly in Studio, no external recorder needed</li>
        <li><strong>Multi-Segment Recording</strong> — stop and redo any part that didn't land</li>
        <li><strong>Reorder &amp; Stitch</strong> — arrange the keepers into one continuous take</li>
      </ul>
    </div>
  </section>

  <!-- Feature: Voice conversion -->
  <section class="feature-section fade-in">
    <div class="feature-icon">🔁</div>
    <div class="feature-body">
      <h2>Convert any take through any voice in your library.</h2>
      <p>
        Once a take is stitched together, run it through any voice from Talent. The
        performance — the timing, the emotion, the delivery — stays yours. The voice carrying
        it is whichever one you've cast for the character.
      </p>
      <div class="mini-feature-grid">
        <div class="mini-feature">
          <h3>WAV</h3>
          <p>Uncompressed, for further editing or archival.</p>
        </div>
        <div class="mini-feature">
          <h3>AIFF</h3>
          <p>Apple's native uncompressed format.</p>
        </div>
        <div class="mini-feature">
          <h3>M4A</h3>
          <p>Compressed and portable, for quick sharing or playback.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature: Session persistence -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">💾</div>
    <div class="feature-body">
      <h2>Nothing is lost if you quit mid-project.</h2>
      <p>
        Your takes, your character assignments, and your selected voice are all saved with
        the session. Close Studio in the middle of a scene and reopen it exactly where you
        left off — no re-recording, no re-assigning, no lost work.
      </p>
    </div>
  </section>

  <!-- Feature: Accessibility -->
  <section class="feature-section fade-in">
    <div class="feature-icon">💙</div>
    <div class="feature-body">
      <h2>Built, in part, for a voice that can't carry a role anymore.</h2>
      <p>
        Studio exists for a real reason beyond convenience: a performer whose own voice or
        vocal cords can't carry a role the way they used to can still deliver the performance
        — the timing, the emotion, the intent — and let a trained AI voice carry it through.
        This is a genuine, felt use case for Studio, not a marketing angle.
      </p>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section fade-in">
    <h2>Simple, honest pricing.</h2>
    <div class="pricing-cards">
      <div class="pricing-card">
        <h3>Free Trial</h3>
        <div class="price">14 days</div>
        <div class="price-detail">no credit card required</div>
        <ul>
          <li>Full recording &amp; conversion — no limits</li>
          <li>Multi-segment recording &amp; stitching</li>
          <li>Convert through any Talent voice</li>
          <li>Export to WAV, AIFF, or M4A</li>
          <li>Session persistence</li>
        </ul>
      </div>
      <div class="pricing-card featured">
        <h3>Studio</h3>
        <div class="price">$44.99</div>
        <div class="price-detail">one-time purchase · no subscription</div>
        <ul>
          <li>Everything in the trial</li>
          <li>Buy once · yours forever</li>
          <li>Free updates</li>
          <li>macOS 14 Sonoma or later</li>
        </ul>
      </div>
    </div>
    <p class="pricing-compare">
      Recording is one part of the pipeline. Get Studio and 4 more apps in the
      <a href="/products/polyspeak">PolySpeak bundle</a> for $129 — save $61
      versus buying separately.
    </p>
  </section>

  <!-- FAQ -->
  <AppFAQ items={[
    {
      question: "Do I need to record my performance in one perfect take?",
      answer: "No. Studio's multi-segment recording is built for the opposite reality — stop, redo any part that didn't land, reorder the keepers, and stitch them into one continuous take. Most real performances are built from several attempts, not one unbroken run."
    },
    {
      question: "Do I need Talent to convert a take?",
      answer: "You need a voice to convert through, which normally comes from your Talent library — Studio and Talent share one voice library across the suite, so a voice trained or imported in Talent is instantly available in Studio."
    },
    {
      question: "What audio formats does Studio export?",
      answer: "WAV and AIFF for uncompressed, editing-ready audio, and M4A for a compressed, portable file — pick whichever fits where the finished track is going next."
    },
    {
      question: "What happens if I quit Studio mid-session?",
      answer: "Nothing is lost. Your takes, your character assignments, and your selected voice are all saved with the session, and reopening the project restores exactly where you left off."
    },
    {
      question: "Is Studio really meant for people who can't perform in their own voice anymore?",
      answer: "Yes, genuinely. Studio was built in part for a performer whose voice or vocal cords can't carry a role the way they used to — they deliver the performance, and a trained AI voice carries it. It's a real use case behind the app, not a marketing line."
    },
    {
      question: "Is Studio included in the PolySpeak bundle?",
      answer: "Yes. The PolySpeak bundle includes Studio, PolyScript, TableRead, Talent, and PolyProject for $129 one-time — a savings of $61 versus the $189.95 combined individual price. See the full breakdown on the PolySpeak bundle page."
    }
  ]} />

  <!-- Waitlist -->
  <section class="waitlist-section fade-in">
    <EmailCapture app="Studio" />
    <p class="privacy-note">
      By joining you agree to our <a href="/terms">Terms of Use</a>.
      Read the <a href="/privacy/studio">Studio Privacy Policy</a>.
    </p>
  </section>

</BaseLayout>

<style>
  .product-hero {
    text-align: center;
    padding: 4rem 0 3rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .product-icon {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    margin-bottom: 1.5rem;
  }

  .product-hero h1 { font-size: 2.75rem; margin-bottom: 0.5rem; }

  .tagline {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--gray-dark);
    margin-bottom: 1.5rem;
  }

  .hero-meta { font-size: 0.9rem; color: var(--gray); }

  /* Three-level callouts */
  .three-levels {
    display: flex;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--gray-light);
  }

  .level {
    flex: 1;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .level-num {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--blue);
    margin-bottom: 0.5rem;
  }

  .level h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }

  .level p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--gray-dark);
    margin: 0;
  }

  /* Feature sections */
  .feature-section {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
    max-width: 900px;
    margin: 0 auto;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--gray-light);
  }

  .feature-section.alt {
    background: var(--gray-light);
    padding: 3.5rem 1.5rem;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    border-bottom: none;
    justify-content: center;
  }

  .feature-section.alt > * { max-width: 420px; }

  .feature-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
    width: 56px;
    text-align: center;
    padding-top: 0.25rem;
  }

  .feature-body { flex: 1; max-width: 820px; }
  .feature-body h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  .feature-body p { font-size: 1.05rem; line-height: 1.7; margin-bottom: 1rem; }

  .feature-list {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .feature-list li {
    padding: 0.65rem 0;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    color: var(--gray-dark);
    border-bottom: 1px solid var(--gray-light);
    position: relative;
    line-height: 1.5;
  }

  .feature-list li::before { content: "→"; position: absolute; left: 0; color: var(--blue); }

  .mini-feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .mini-feature {
    background: #fff;
    border-radius: 10px;
    padding: 1rem 1.25rem;
  }

  .mini-feature h3 { font-size: 0.9rem; font-weight: 600; color: var(--blue); margin-bottom: 0.35rem; }
  .mini-feature p  { font-size: 0.88rem; margin: 0; color: var(--gray-dark); }

  /* Pricing */
  .pricing-section {
    max-width: 760px;
    margin: 0 auto;
    padding: 3.5rem 0;
    text-align: center;
    border-bottom: none;
  }

  .pricing-section h2 { font-size: 1.6rem; margin-bottom: 2rem; }

  .pricing-cards { display: flex; gap: 1.5rem; justify-content: center; }

  .pricing-card {
    flex: 1;
    max-width: 320px;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.75rem;
    text-align: left;
  }

  .pricing-card.featured { background: var(--blue); color: #fff; }
  .pricing-card h3 { font-size: 1rem; margin-bottom: 0.75rem; }
  .pricing-card.featured h3 { color: rgba(255,255,255,0.8); }

  .price { font-size: 2rem; font-weight: 700; margin-bottom: 0.25rem; }

  .price-detail {
    font-size: 0.8rem;
    opacity: 0.75;
    margin-bottom: 1rem;
    color: var(--gray-dark);
  }

  .pricing-card.featured .price-detail { color: rgba(255,255,255,0.7); }

  .pricing-card ul { list-style: none; padding: 0; margin-top: 1rem; }

  .pricing-card ul li {
    font-size: 0.9rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    color: var(--gray-dark);
  }

  .pricing-card.featured ul li {
    border-color: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.9);
  }

  .pricing-card ul li::before { content: "✓  "; }

  .pricing-compare {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--gray);
  }

  .pricing-compare a { color: var(--blue); text-decoration: underline; }

  /* Waitlist */
  .waitlist-section { padding: 1rem 0 3rem; border-bottom: none; }

  .privacy-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--gray);
    margin-top: -1.5rem;
  }

  .privacy-note a { color: var(--gray-dark); text-decoration: underline; }
  .privacy-note a:hover { color: var(--blue); }

  @media (max-width: 768px) {
    .three-levels { flex-direction: column; }

    .feature-section,
    .feature-section.alt {
      flex-direction: column;
      gap: 1.25rem;
      padding: 2.5rem 1rem;
      margin-left: 0;
      margin-right: 0;
      width: 100%;
      left: 0;
      right: 0;
    }

    .mini-feature-grid { grid-template-columns: 1fr; }
    .pricing-cards { flex-direction: column; align-items: stretch; }
    .pricing-card { max-width: 100%; }
  }
</style>
