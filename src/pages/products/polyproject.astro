---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppFAQ from "../../components/AppFAQ.astro";

const icon = "/images/products/comingsoon/icon1.png";
---

<BaseLayout
  title="PolyProject — Production Tracker for the PolySpeak Suite"
  description="PolyProject tracks a screenplay through Script, Casting, Table Read, and Performance Capture — staying in sync automatically as the other PolySpeak apps finish their steps. Included free with the PolySpeak bundle, not sold separately."
>

  <!-- Hero -->
  <section class="product-hero fade-in">
    <img src={icon} alt="PolyProject" class="product-icon" />
    <h1>PolyProject</h1>
    <p class="tagline">The whole production, tracked in one place.</p>
    <p class="hero-sub">
      A four-stage tracker — Script, Casting, Table Read, Performance Capture — that stays
      in sync automatically as PolyScript, TableRead, and Studio finish their steps. One
      button jumps you straight into the right app for whatever's next.
    </p>
    <div class="hero-meta">macOS 14 Sonoma or later</div>
    <div class="bundle-callout">
      <strong>Included free with the PolySpeak bundle</strong>
      <p>PolyProject isn't sold on its own — its whole job is coordinating the other four apps, so it only makes sense once you own enough of the suite to have something to track. It's the free payoff for buying the bundle.</p>
      <a href="/products/polyspeak" class="bundle-link">See the PolySpeak bundle →</a>
    </div>
  </section>

  <!-- Pipeline position -->
  <section class="three-levels fade-in">
    <div class="level">
      <div class="level-num">STEP 5</div>
      <h3>Track</h3>
      <p>PolyProject is the dashboard for everything the other four apps produce.</p>
    </div>
    <div class="level">
      <div class="level-num">INPUT</div>
      <h3>The Other Apps' Output</h3>
      <p>A script from PolyScript, casting and a read-through from TableRead, exports from Studio — PolyProject watches for all of it.</p>
    </div>
    <div class="level">
      <div class="level-num">OUTPUT</div>
      <h3>One Clear Status</h3>
      <p>See exactly what's done and what's next, and jump straight into the right app to keep moving.</p>
    </div>
  </section>

  <!-- Feature: Four stages -->
  <section class="feature-section fade-in">
    <div class="feature-icon">📊</div>
    <div class="feature-body">
      <h2>Four stages. Always current.</h2>
      <p>
        Every project tracks the same four stages, in order, with a live status for each —
        no manual checkboxes to remember to update.
      </p>
      <ul class="feature-list">
        <li><strong>Script</strong> — the screenplay this project is built around</li>
        <li><strong>Casting</strong> — which characters are cast, and with which voice</li>
        <li><strong>Table Read</strong> — whether a full AI read-through has been generated</li>
        <li><strong>Performance Capture</strong> — which characters have a finished, exported take</li>
      </ul>
    </div>
  </section>

  <!-- Feature: Auto-sync -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">🔄</div>
    <div class="feature-body">
      <h2>No manual bookkeeping.</h2>
      <p>
        Generate a read-through in TableRead, or export a take in Studio, and PolyProject
        picks it up automatically the next time its window is in front — no re-importing,
        no status you have to remember to flip yourself.
      </p>
    </div>
  </section>

  <!-- Feature: Jump to app -->
  <section class="feature-section fade-in">
    <div class="feature-icon">🚀</div>
    <div class="feature-body">
      <h2>One click into the right app.</h2>
      <p>
        Every stage has a button that opens exactly the app and file you need next —
        the script in PolyScript, casting in TableRead, or a take in Studio — so PolyProject
        stays the map, not another place you have to do the work.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <AppFAQ items={[
    {
      question: "Why isn't PolyProject sold on its own?",
      answer: "Because it has nothing to track without the other apps. PolyProject's entire job is showing live status across Script, Casting, Table Read, and Performance Capture — stages that only exist once you're using PolyScript, TableRead, Talent, and Studio. It's included free with the PolySpeak bundle rather than sold as an empty shell."
    },
    {
      question: "Do I need every other PolySpeak app for PolyProject to be useful?",
      answer: "You get the most out of it with all four, but it will show whatever progress exists — a script with no casting yet, for example, still shows the Script stage complete and the rest pending. It's a live dashboard, not an all-or-nothing gate."
    },
    {
      question: "How does PolyProject know when another app finishes a step?",
      answer: "It watches for the standard files the other apps produce — a saved script, a generated read-through, an exported performance capture — and reads their status automatically. No manual syncing or exporting between apps is required."
    },
    {
      question: "Can I export or print a project's status?",
      answer: "Yes. PolyProject can export finished performance captures and print a project summary showing where every stage stands."
    }
  ]} />

</BaseLayout>

<style>
  .product-hero {
    text-align: center;
    padding: 4rem 0 3rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .product-icon {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    margin-bottom: 1.5rem;
  }

  .product-hero h1 { font-size: 2.75rem; margin-bottom: 0.5rem; }

  .tagline {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--gray-dark);
    margin-bottom: 1.5rem;
  }

  .hero-meta { font-size: 0.9rem; color: var(--gray); margin-bottom: 1.5rem; }

  .bundle-callout {
    background: var(--blue-light);
    border-left: 4px solid var(--blue);
    border-radius: 0 10px 10px 0;
    padding: 1.25rem 1.5rem;
    text-align: left;
    max-width: 520px;
    margin: 0 auto;
  }

  .bundle-callout strong { display: block; font-size: 1.02rem; margin-bottom: 0.4rem; color: #1a3a7a; }
  .bundle-callout p { font-size: 0.92rem; color: var(--gray-dark); margin-bottom: 0.75rem; }
  .bundle-link { font-size: 0.92rem; font-weight: 600; color: var(--blue); text-decoration: none; }
  .bundle-link:hover { text-decoration: underline; }

  .three-levels {
    display: flex;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--gray-light);
  }

  .level {
    flex: 1;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .level-num {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--blue);
    margin-bottom: 0.5rem;
  }

  .level h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }

  .level p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--gray-dark);
    margin: 0;
  }

  .feature-section {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
    max-width: 900px;
    margin: 0 auto;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--gray-light);
  }

  .feature-section.alt {
    background: var(--gray-light);
    padding: 3.5rem 1.5rem;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    border-bottom: none;
    justify-content: center;
  }

  .feature-section.alt > * { max-width: 420px; }

  .feature-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
    width: 56px;
    text-align: center;
    padding-top: 0.25rem;
  }

  .feature-body { flex: 1; max-width: 820px; }
  .feature-body h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  .feature-body p { font-size: 1.05rem; line-height: 1.7; margin-bottom: 1rem; }

  .feature-list {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .feature-list li {
    padding: 0.65rem 0;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    color: var(--gray-dark);
    border-bottom: 1px solid var(--gray-light);
    position: relative;
    line-height: 1.5;
  }

  .feature-list li::before { content: "→"; position: absolute; left: 0; color: var(--blue); }

  .waitlist-section { padding: 1rem 0 3rem; border-bottom: none; }

  .privacy-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--gray);
    margin-top: -1.5rem;
  }

  .privacy-note a { color: var(--gray-dark); text-decoration: underline; }
  .privacy-note a:hover { color: var(--blue); }

  @media (max-width: 768px) {
    .three-levels { flex-direction: column; }

    .feature-section,
    .feature-section.alt {
      flex-direction: column;
      gap: 1.25rem;
      padding: 2.5rem 1rem;
      margin-left: 0;
      margin-right: 0;
      width: 100%;
      left: 0;
      right: 0;
    }
  }
</style>
