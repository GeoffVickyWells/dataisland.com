---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppFAQ from "../../components/AppFAQ.astro";
import AppStoreCTA from "../../components/AppStoreCTA.astro";

const icon = "/images/products/comingsoon/icon1.png";
---

<BaseLayout
  title="TableRead — AI Read-Throughs for Mac"
  description="TableRead casts every character in a screenplay with a voice from your library and generates a full AI read-through — or just one scene — before you commit to performance capture. $34.99, one-time purchase, or get all 5 PolySpeak apps for $129."
>

  <!-- Hero -->
  <section class="product-hero fade-in">
    <img src={icon} alt="TableRead" class="product-icon" />
    <h1>TableRead</h1>
    <p class="tagline">Hear your script before anyone else does.</p>
    <p class="hero-sub">
      Cast every character in your screenplay with a voice from your library, then generate
      a full AI read-through of the whole script — or just a scene — to hear how the cast
      works together before committing to real performance capture in Studio.
    </p>
    <div class="hero-meta">macOS 14 Sonoma or later &nbsp;·&nbsp; 14-day free trial &nbsp;·&nbsp; $34.99 one-time purchase</div>
    <AppStoreCTA />
  </section>

  <!-- Pipeline position -->
  <section class="three-levels fade-in">
    <div class="level">
      <div class="level-num">STEP 2</div>
      <h3>Cast</h3>
      <p>TableRead is where casting happens — assign a voice from Talent to every character before anyone records a real performance.</p>
    </div>
    <div class="level">
      <div class="level-num">INPUT</div>
      <h3>Any .fountain File</h3>
      <p>Open a screenplay from PolyScript, or from any other Fountain-compatible screenwriting app. PolyScript isn't required.</p>
    </div>
    <div class="level">
      <div class="level-num">OUTPUT</div>
      <h3>A Full Read-Through</h3>
      <p>Hear the entire cast together before real performance capture in Studio — catch casting problems while they're still cheap to fix.</p>
    </div>
  </section>

  <!-- Feature: Casting -->
  <section class="feature-section fade-in">
    <div class="feature-icon">🎭</div>
    <div class="feature-body">
      <h2>Cast the whole script, character by character.</h2>
      <p>
        Every character detected in your screenplay gets its own casting slot. Assign a
        voice from your Talent library to each one, and TableRead remembers the assignment
        for the whole script.
      </p>
      <div class="mini-feature-grid">
        <div class="mini-feature">
          <h3>Full Cast Assignment</h3>
          <p>Every character in the script gets a dedicated voice slot, pulled straight from your Talent library.</p>
        </div>
        <div class="mini-feature">
          <h3>Import a Voice Directly</h3>
          <p>Don't have Talent installed? Import a voice straight from an existing .pth model file — Talent is not required.</p>
        </div>
        <div class="mini-feature">
          <h3>Works With Any Screenplay</h3>
          <p>Open any standard .fountain file from any screenwriting app. PolyScript is not required either.</p>
        </div>
        <div class="mini-feature">
          <h3>Save &amp; Save As</h3>
          <p>Cast assignments and generated audio save with the project — proper Save/Save As, with Finder file-type integration.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature: AI read-through -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">🔊</div>
    <div class="feature-body">
      <h2>Generate a full read-through — or just one scene.</h2>
      <ul class="feature-list">
        <li><strong>Full Script</strong> — generate an AI read-through of the entire screenplay in one pass, every character voiced</li>
        <li><strong>Selection Only</strong> — test one scene, or a handful of lines, without regenerating the whole script</li>
        <li><strong>Hear It Together</strong> — a read-through reveals how the whole cast plays off each other, before you commit to real performance capture</li>
      </ul>
      <div class="callout">
        A table read is a cheap rehearsal. Catching a casting mismatch here — before Studio,
        before real performance capture — is far less costly than discovering it after a
        recording session.
      </div>
    </div>
  </section>

  <!-- Feature: Standalone & compatibility -->
  <section class="feature-section fade-in">
    <div class="feature-icon">🔗</div>
    <div class="feature-body">
      <h2>Nothing about TableRead requires the rest of PolySpeak.</h2>
      <p>
        TableRead reads standard .fountain files and imports standard .pth voice models —
        both open interchange formats, not proprietary lock-in. Bring a script from any
        screenwriting app and a voice from any RVC training pipeline, and TableRead works.
      </p>
      <ul class="feature-list">
        <li><strong>Screenplay input</strong> — .fountain, from PolyScript or any compatible app</li>
        <li><strong>Voice input</strong> — cast from Talent, or import a .pth model directly</li>
        <li><strong>Output</strong> — a cast read-through, ready to hand off to Studio for real capture</li>
      </ul>
    </div>
  </section>

  <!-- Feature: What else -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">⚡</div>
    <div class="feature-body">
      <h2>The rest of what a casting app should have.</h2>
      <div class="mini-feature-grid">
        <div class="mini-feature">
          <h3>Multi-Window</h3>
          <p>Work on more than one project's casting at a time.</p>
        </div>
        <div class="mini-feature">
          <h3>Proper Save / Save As</h3>
          <p>Cast lists and generated read-throughs save like any native Mac document.</p>
        </div>
        <div class="mini-feature">
          <h3>Finder File-Type Integration</h3>
          <p>Drag a .fountain or .fusiondoc script onto TableRead's Dock icon to open it directly — or set TableRead as the default for a file type yourself (Finder → Get Info → Open with → Change All).</p>
        </div>
        <div class="mini-feature">
          <h3>Shared Voice Library</h3>
          <p>Cast from the same Talent library used across TableRead and Studio — train or import a voice once, use it anywhere.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section fade-in">
    <h2>Simple, honest pricing.</h2>
    <div class="pricing-cards">
      <div class="pricing-card">
        <h3>Free Trial</h3>
        <div class="price">14 days</div>
        <div class="price-detail">no credit card required</div>
        <ul>
          <li>Full casting workflow — no limits</li>
          <li>Full-script &amp; selection read-throughs</li>
          <li>Import voices from .pth models</li>
          <li>Works with any .fountain screenplay</li>
          <li>Save / Save As, Finder integration</li>
        </ul>
      </div>
      <div class="pricing-card featured">
        <h3>TableRead</h3>
        <div class="price">$34.99</div>
        <div class="price-detail">one-time purchase · no subscription</div>
        <ul>
          <li>Everything in the trial</li>
          <li>Buy once · yours forever</li>
          <li>Free updates</li>
          <li>macOS 14 Sonoma or later</li>
        </ul>
      </div>
    </div>
    <p class="pricing-compare">
      Casting is only one step. Get TableRead and 4 more apps in the
      <a href="/products/polyspeak">PolySpeak bundle</a> for $129 — save $61
      versus buying separately.
    </p>
  </section>

  <!-- FAQ -->
  <AppFAQ items={[
    {
      question: "Do I need PolyScript to use TableRead?",
      answer: "No. TableRead opens any standard .fountain screenplay, whether it came from PolyScript, Final Draft, Highland, WriterDuet, Slugline, or any other Fountain-compatible app. Fountain is the interchange format, not a PolyScript-specific one."
    },
    {
      question: "Do I need Talent to cast a script?",
      answer: "No. While TableRead's Talent integration lets you cast straight from your voice library, you can also import a voice directly from an existing .pth model file without Talent installed at all."
    },
    {
      question: "What's the difference between a full read-through and a selection read-through?",
      answer: "A full read-through generates AI audio for the entire cast across the whole script in one pass. A selection read-through generates audio for just the scene or lines you've selected — useful for testing a single moment or one character's voice without waiting for a full regeneration."
    },
    {
      question: "Is a TableRead read-through the same as the final performance?",
      answer: "No — a table read is a fast, low-cost rehearsal step. It exists to catch casting mismatches or tone problems early. Real performance capture — recording actual takes, converting them through a cast voice, and exporting a finished track — happens in Studio."
    },
    {
      question: "Can I use TableRead on its own, without the rest of PolySpeak?",
      answer: "Yes. TableRead works with any .fountain script and any .pth voice model, so it functions as a standalone casting tool. The PolySpeak bundle exists for convenience and savings across the whole pipeline, not because TableRead is limited alone."
    },
    {
      question: "Is TableRead included in the PolySpeak bundle?",
      answer: "Yes. The PolySpeak bundle includes TableRead, PolyScript, Talent, Studio, and PolyProject for $129 one-time — a savings of $61 versus the $189.95 combined individual price. See the full breakdown on the PolySpeak bundle page."
    }
  ]} />

</BaseLayout>

<style>
  .product-hero {
    text-align: center;
    padding: 4rem 0 3rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .product-icon {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    margin-bottom: 1.5rem;
  }

  .product-hero h1 { font-size: 2.75rem; margin-bottom: 0.5rem; }

  .tagline {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--gray-dark);
    margin-bottom: 1.5rem;
  }

  .hero-meta { font-size: 0.9rem; color: var(--gray); }

  /* Three-level callouts */
  .three-levels {
    display: flex;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--gray-light);
  }

  .level {
    flex: 1;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .level-num {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--blue);
    margin-bottom: 0.5rem;
  }

  .level h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }

  .level p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--gray-dark);
    margin: 0;
  }

  /* Feature sections */
  .feature-section {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
    max-width: 900px;
    margin: 0 auto;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--gray-light);
  }

  .feature-section.alt {
    background: var(--gray-light);
    padding: 3.5rem 1.5rem;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    border-bottom: none;
    justify-content: center;
  }

  .feature-section.alt > * { max-width: 420px; }

  .feature-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
    width: 56px;
    text-align: center;
    padding-top: 0.25rem;
  }

  .feature-body { flex: 1; max-width: 820px; }
  .feature-body h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  .feature-body p { font-size: 1.05rem; line-height: 1.7; margin-bottom: 1rem; }

  .callout {
    background: var(--blue-light);
    border-left: 4px solid var(--blue);
    border-radius: 0 10px 10px 0;
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
    color: var(--gray-dark);
    margin-top: 1rem;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .feature-list li {
    padding: 0.65rem 0;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    color: var(--gray-dark);
    border-bottom: 1px solid var(--gray-light);
    position: relative;
    line-height: 1.5;
  }

  .feature-list li::before { content: "→"; position: absolute; left: 0; color: var(--blue); }

  .mini-feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .mini-feature {
    background: #fff;
    border-radius: 10px;
    padding: 1rem 1.25rem;
  }

  .mini-feature h3 { font-size: 0.9rem; font-weight: 600; color: var(--blue); margin-bottom: 0.35rem; }
  .mini-feature p  { font-size: 0.88rem; margin: 0; color: var(--gray-dark); }

  /* Pricing */
  .pricing-section {
    max-width: 760px;
    margin: 0 auto;
    padding: 3.5rem 0;
    text-align: center;
    border-bottom: none;
  }

  .pricing-section h2 { font-size: 1.6rem; margin-bottom: 2rem; }

  .pricing-cards { display: flex; gap: 1.5rem; justify-content: center; }

  .pricing-card {
    flex: 1;
    max-width: 320px;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.75rem;
    text-align: left;
  }

  .pricing-card.featured { background: var(--blue); color: #fff; }
  .pricing-card h3 { font-size: 1rem; margin-bottom: 0.75rem; }
  .pricing-card.featured h3 { color: rgba(255,255,255,0.8); }

  .price { font-size: 2rem; font-weight: 700; margin-bottom: 0.25rem; }

  .price-detail {
    font-size: 0.8rem;
    opacity: 0.75;
    margin-bottom: 1rem;
    color: var(--gray-dark);
  }

  .pricing-card.featured .price-detail { color: rgba(255,255,255,0.7); }

  .pricing-card ul { list-style: none; padding: 0; margin-top: 1rem; }

  .pricing-card ul li {
    font-size: 0.9rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    color: var(--gray-dark);
  }

  .pricing-card.featured ul li {
    border-color: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.9);
  }

  .pricing-card ul li::before { content: "✓  "; }

  .pricing-compare {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--gray);
  }

  .pricing-compare a { color: var(--blue); text-decoration: underline; }

  /* Waitlist */
  .waitlist-section { padding: 1rem 0 3rem; border-bottom: none; }

  .privacy-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--gray);
    margin-top: -1.5rem;
  }

  .privacy-note a { color: var(--gray-dark); text-decoration: underline; }
  .privacy-note a:hover { color: var(--blue); }

  @media (max-width: 768px) {
    .three-levels { flex-direction: column; }

    .feature-section,
    .feature-section.alt {
      flex-direction: column;
      gap: 1.25rem;
      padding: 2.5rem 1rem;
      margin-left: 0;
      margin-right: 0;
      width: 100%;
      left: 0;
      right: 0;
    }

    .mini-feature-grid { grid-template-columns: 1fr; }
    .pricing-cards { flex-direction: column; align-items: stretch; }
    .pricing-card { max-width: 100%; }
  }
</style>
