---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import AppFAQ from "../../components/AppFAQ.astro";
import AppStoreCTA from "../../components/AppStoreCTA.astro";

const icon = "/images/products/comingsoon/icon1.png";
---

<BaseLayout
  title="Talent — AI Voice Library for Mac"
  description="Talent trains custom AI voices from your own recordings, or imports existing RVC models. Consent tracking, catalog numbers, and a resume for every voice — shared across the whole PolySpeak suite. $54.99, one-time purchase, or get all 5 PolySpeak apps for $129."
>

  <!-- Hero -->
  <section class="product-hero fade-in">
    <img src={icon} alt="Talent" class="product-icon" />
    <h1>Talent</h1>
    <p class="tagline">Your voice library. Every voice you've built or borrowed.</p>
    <p class="hero-sub">
      Train a custom AI voice from your own recording, or import an existing RVC model.
      Every voice gets a catalog number, a consent record, and a resume that fills in
      automatically as it's cast across the suite.
    </p>
    <div class="hero-meta">macOS 14 Sonoma or later &nbsp;·&nbsp; 14-day free trial &nbsp;·&nbsp; $54.99 one-time purchase</div>
    <AppStoreCTA />
  </section>

  <!-- Pipeline position -->
  <section class="three-levels fade-in">
    <div class="level">
      <div class="level-num">STEP 3</div>
      <h3>Cast</h3>
      <p>Talent is where a voice is born — trained from a real recording or brought in from elsewhere.</p>
    </div>
    <div class="level">
      <div class="level-num">INPUT</div>
      <h3>A Recording, or a Model</h3>
      <p>10–30 minutes of source audio to train from scratch, or an existing .pth model to import directly.</p>
    </div>
    <div class="level">
      <div class="level-num">OUTPUT</div>
      <h3>One Shared Library</h3>
      <p>Every voice you build or import is instantly available to TableRead and Studio — cast once, use anywhere in the suite.</p>
    </div>
  </section>

  <!-- Feature: Two paths -->
  <section class="feature-section fade-in">
    <div class="feature-icon">🎤</div>
    <div class="feature-body">
      <h2>Two ways to get a voice into your library.</h2>
      <p>
        Train one from scratch, or bring one you already have. Either way, it lands in the
        same library, ready to cast.
      </p>
      <ul class="feature-list">
        <li><strong>Train from a Recording</strong> — record or import roughly 10–30 minutes of source audio, name it, and train</li>
        <li><strong>Import an Existing Model</strong> — point at an existing RVC .pth (and optional .index) file and register it directly, no training required</li>
        <li><strong>Real Preview</strong> — hear an actual converted sample of a freshly trained voice, not a placeholder</li>
        <li><strong>Shared Everywhere</strong> — every voice is instantly available in TableRead and Studio, no export/import step between apps</li>
      </ul>
    </div>
  </section>

  <!-- Feature: Consent & status -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">✅</div>
    <div class="feature-body">
      <h2>Consent and quality control, built into the model.</h2>
      <div class="mini-feature-grid">
        <div class="mini-feature">
          <h3>Consent Tracking</h3>
          <p>A consent attestation is recorded alongside every trained voice — because training a voice model from someone's recording is a real responsibility, not just a technical step.</p>
        </div>
        <div class="mini-feature">
          <h3>Catalog Numbers</h3>
          <p>Every voice gets a permanent, human-friendly catalog number — easy to reference, easy to keep straight across a growing library.</p>
        </div>
        <div class="mini-feature">
          <h3>Testing vs. Ready for Casting</h3>
          <p>Flag a voice as still-testing while you evaluate it, then mark it Ready for Casting once you trust it for real production work.</p>
        </div>
        <div class="mini-feature">
          <h3>On-Device, Always</h3>
          <p>Training and conversion run entirely on your Mac. No recording, no voice model, is ever uploaded anywhere.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature: Resume -->
  <section class="feature-section fade-in">
    <div class="feature-icon">📋</div>
    <div class="feature-body">
      <h2>A resume that fills itself in.</h2>
      <p>
        Every voice keeps a running record of which projects and characters it's performed —
        credited automatically the moment TableRead generates a read-through or Studio
        exports a finished take. No spreadsheet, no manual bookkeeping.
      </p>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section fade-in">
    <h2>Simple, honest pricing.</h2>
    <div class="pricing-cards">
      <div class="pricing-card">
        <h3>Free Trial</h3>
        <div class="price">14 days</div>
        <div class="price-detail">no credit card required</div>
        <ul>
          <li>Full training &amp; import — no limits</li>
          <li>Consent tracking &amp; catalog numbers</li>
          <li>Testing / Ready for Casting status</li>
          <li>Voice resume &amp; credits</li>
          <li>Shared library across the suite</li>
        </ul>
      </div>
      <div class="pricing-card featured">
        <h3>Talent</h3>
        <div class="price">$54.99</div>
        <div class="price-detail">one-time purchase · no subscription</div>
        <ul>
          <li>Everything in the trial</li>
          <li>Buy once · yours forever</li>
          <li>Free updates</li>
          <li>macOS 14 Sonoma or later</li>
        </ul>
      </div>
    </div>
    <p class="pricing-compare">
      Talent is the deepest tech in the suite. Get it and 4 more apps in the
      <a href="/products/polyspeak">PolySpeak bundle</a> for $129 — save $61
      versus buying separately.
    </p>
  </section>

  <!-- FAQ -->
  <AppFAQ items={[
    {
      question: "How much recording do I need to train a voice?",
      answer: "Roughly 10 to 30 minutes of clean source audio. Record it directly or import an existing recording — either way, Talent walks you through naming the voice and setting how many training epochs to run."
    },
    {
      question: "Can I use a voice model I already trained elsewhere?",
      answer: "Yes. Talent can import an existing RVC .pth model file (with an optional .index file) directly, no retraining required — it's registered into your library the same way a freshly trained voice would be."
    },
    {
      question: "Do I need consent to train a voice from someone's recording?",
      answer: "Yes, and it's your responsibility as the user to have it, or use only your own voice. Talent records a consent attestation alongside every trained voice, but DataIsland cannot verify real-world consent — see our Terms of Use for the full policy."
    },
    {
      question: "Does any of my recorded audio leave my Mac?",
      answer: "No. Voice training and conversion run entirely on-device through a local pipeline. Nothing is uploaded to DataIsland or any third party at any point."
    },
    {
      question: "Do I need TableRead or Studio to use Talent?",
      answer: "No — Talent is a complete, standalone voice library on its own. TableRead and Studio become more useful once you have voices to cast, but training and managing a library works fully without either app installed."
    },
    {
      question: "Is Talent included in the PolySpeak bundle?",
      answer: "Yes. The PolySpeak bundle includes Talent, PolyScript, TableRead, Studio, and PolyProject for $129 one-time — a savings of $61 versus the $189.95 combined individual price. See the full breakdown on the PolySpeak bundle page."
    }
  ]} />

  <!-- Waitlist -->
  <section class="waitlist-section fade-in">
    <EmailCapture app="Talent" />
    <p class="privacy-note">
      By joining you agree to our <a href="/terms">Terms of Use</a>.
      Read the <a href="/privacy/talent">Talent Privacy Policy</a>.
    </p>
  </section>

</BaseLayout>

<style>
  .product-hero {
    text-align: center;
    padding: 4rem 0 3rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .product-icon {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    margin-bottom: 1.5rem;
  }

  .product-hero h1 { font-size: 2.75rem; margin-bottom: 0.5rem; }

  .tagline {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--gray-dark);
    margin-bottom: 1.5rem;
  }

  .hero-meta { font-size: 0.9rem; color: var(--gray); }

  .three-levels {
    display: flex;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--gray-light);
  }

  .level {
    flex: 1;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .level-num {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--blue);
    margin-bottom: 0.5rem;
  }

  .level h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }

  .level p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--gray-dark);
    margin: 0;
  }

  .feature-section {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
    max-width: 900px;
    margin: 0 auto;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--gray-light);
  }

  .feature-section.alt {
    background: var(--gray-light);
    padding: 3.5rem 1.5rem;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    border-bottom: none;
    justify-content: center;
  }

  .feature-section.alt > * { max-width: 420px; }

  .feature-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
    width: 56px;
    text-align: center;
    padding-top: 0.25rem;
  }

  .feature-body { flex: 1; max-width: 820px; }
  .feature-body h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  .feature-body p { font-size: 1.05rem; line-height: 1.7; margin-bottom: 1rem; }

  .feature-list {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .feature-list li {
    padding: 0.65rem 0;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    color: var(--gray-dark);
    border-bottom: 1px solid var(--gray-light);
    position: relative;
    line-height: 1.5;
  }

  .feature-list li::before { content: "→"; position: absolute; left: 0; color: var(--blue); }

  .mini-feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .mini-feature {
    background: #fff;
    border-radius: 10px;
    padding: 1rem 1.25rem;
  }

  .mini-feature h3 { font-size: 0.9rem; font-weight: 600; color: var(--blue); margin-bottom: 0.35rem; }
  .mini-feature p  { font-size: 0.88rem; margin: 0; color: var(--gray-dark); }

  .pricing-section {
    max-width: 760px;
    margin: 0 auto;
    padding: 3.5rem 0;
    text-align: center;
    border-bottom: none;
  }

  .pricing-section h2 { font-size: 1.6rem; margin-bottom: 2rem; }

  .pricing-cards { display: flex; gap: 1.5rem; justify-content: center; }

  .pricing-card {
    flex: 1;
    max-width: 320px;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.75rem;
    text-align: left;
  }

  .pricing-card.featured { background: var(--blue); color: #fff; }
  .pricing-card h3 { font-size: 1rem; margin-bottom: 0.75rem; }
  .pricing-card.featured h3 { color: rgba(255,255,255,0.8); }

  .price { font-size: 2rem; font-weight: 700; margin-bottom: 0.25rem; }

  .price-detail {
    font-size: 0.8rem;
    opacity: 0.75;
    margin-bottom: 1rem;
    color: var(--gray-dark);
  }

  .pricing-card.featured .price-detail { color: rgba(255,255,255,0.7); }

  .pricing-card ul { list-style: none; padding: 0; margin-top: 1rem; }

  .pricing-card ul li {
    font-size: 0.9rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    color: var(--gray-dark);
  }

  .pricing-card.featured ul li {
    border-color: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.9);
  }

  .pricing-card ul li::before { content: "✓  "; }

  .pricing-compare {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--gray);
  }

  .pricing-compare a { color: var(--blue); text-decoration: underline; }

  .waitlist-section { padding: 1rem 0 3rem; border-bottom: none; }

  .privacy-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--gray);
    margin-top: -1.5rem;
  }

  .privacy-note a { color: var(--gray-dark); text-decoration: underline; }
  .privacy-note a:hover { color: var(--blue); }

  @media (max-width: 768px) {
    .three-levels { flex-direction: column; }

    .feature-section,
    .feature-section.alt {
      flex-direction: column;
      gap: 1.25rem;
      padding: 2.5rem 1rem;
      margin-left: 0;
      margin-right: 0;
      width: 100%;
      left: 0;
      right: 0;
    }

    .mini-feature-grid { grid-template-columns: 1fr; }
    .pricing-cards { flex-direction: column; align-items: stretch; }
    .pricing-card { max-width: 100%; }
  }
</style>
