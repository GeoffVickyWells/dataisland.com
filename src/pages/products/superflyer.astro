---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppFAQ from "../../components/AppFAQ.astro";
import AppStoreCTA from "../../components/AppStoreCTA.astro";

const icon = "/images/products/superflyer/icon.png";
const shots = "/images/products/superflyer";
---

<BaseLayout
  title="SuperFlyer — Comics That Move, for Mac"
  description="Make comics, flyers and picture stories on your Mac — with balloons, sound effects, comic looks and motion — and share them as a flip-book that plays on any phone. Free."
>

  <!-- Hero -->
  <section class="product-hero fade-in">
    <img src={icon} alt="SuperFlyer" class="product-icon" />
    <h1>SuperFlyer</h1>
    <p class="tagline">Comics that move.</p>
    <p class="hero-sub">
      Make a comic, a flyer for your business, or a school project. Drag on speech balloons and
      sound effects, turn photos into comic art, and share it as a flip-book that plays on any phone.
      Draw pictures right on your Mac with Apple's Image Playground.
    </p>
    <div class="hero-meta">macOS 26 or later &nbsp;·&nbsp; Free &nbsp;·&nbsp; No account</div>
    <AppStoreCTA app="superflyer" />
  </section>

  <section class="shot-wrap fade-in">
    <img src={`${shots}/1.jpg`} alt="SuperFlyer editing a superhero comic, with a BOOM! sound effect dropped next to the hero" class="shot" />
  </section>

  <!-- Read the examples -->
  <section class="feature-section fade-in alt">
    <div class="feature-icon">📖</div>
    <div class="feature-body">
      <h2>See what you can make. Read these on your phone.</h2>
      <p>
        These three were made in SuperFlyer, with pictures drawn by Image Playground on a Mac.
        Open one, then swipe or tap to turn the pages. They're also inside the app as templates,
        ready to change.
      </p>
      <div class="example-grid">
        <a class="example" href="/examples/superflyer/captain-clay/" target="_blank" rel="noopener">
          <img src={`${shots}/example-captain-clay.jpg`} alt="Captain Clay comic cover" />
          <strong>Captain Clay</strong>
          <span>A superhero comic</span>
        </a>
        <a class="example" href="/examples/superflyer/waggly-tails/" target="_blank" rel="noopener">
          <img src={`${shots}/example-waggly-tails.jpg`} alt="Waggly Tails Daycare flyer cover" />
          <strong>Waggly Tails Daycare</strong>
          <span>A flyer for a small business</span>
        </a>
        <a class="example" href="/examples/superflyer/water-cycle/" target="_blank" rel="noopener">
          <img src={`${shots}/example-water-cycle.jpg`} alt="The Water Cycle school project cover" />
          <strong>The Water Cycle</strong>
          <span>A school project</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Making -->
  <section class="feature-section fade-in">
    <div class="feature-icon">💥</div>
    <div class="feature-body">
      <h2>Drag it on. Undo anything.</h2>
      <p>
        The effects palette holds speech, thought, shout and whisper balloons, captions, titles,
        and sound effects like POW!, BOOM! and SPLASH! Drag one onto a panel and it lands where
        you drop it. Every change can be undone, so try things.
      </p>
      <div class="mini-feature-grid">
        <div class="mini-feature">
          <h3>Panels your way</h3>
          <p>Thirteen layouts, or drag panels anywhere. Square, rounded, oval or angled, with or without an outline.</p>
        </div>
        <div class="mini-feature">
          <h3>Full-bleed backgrounds</h3>
          <p>Put one big picture behind the whole page and let it show through see-through panels.</p>
        </div>
        <div class="mini-feature">
          <h3>Motion</h3>
          <p>Balloons pop in, titles pulse, pictures slowly zoom. Video clips loop inside panels.</p>
        </div>
        <div class="mini-feature">
          <h3>Any font, any language</h3>
          <p>Every font on your Mac, filtered by language. Arabic and Hebrew read right to left.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="feature-section fade-in alt">
    <div class="feature-icon">🎨</div>
    <div class="feature-body">
      <h2>Pictures, made on your Mac.</h2>
      <p>
        Draw a panel with Apple's Image Playground. Give a character a picture and SuperFlyer
        starts every new drawing from it, so they look the same from panel to panel. Turn photos
        into comic art with Comic Ink, Halftone Dots, Pop Art, Pencil Sketch and Noir, and lift a
        person or pet off their background with Cut Out Subject. All of it runs on your Mac.
      </p>
      <img src={`${shots}/2.jpg`} alt="Comic looks applied to photos in a SuperFlyer flyer" class="shot inline" />
      <p>
        Want more? Add your own OpenRouter key to draw with other image models, or turn a panel
        into a short animated clip. That's optional. Everything else works without it.
      </p>
    </div>
  </section>

  <section class="feature-section fade-in">
    <div class="feature-icon">📱</div>
    <div class="feature-body">
      <h2>Share a flip-book that plays on any phone.</h2>
      <p>
        Export a flip-book: a small website where pages turn, balloons pop and clips loop. Put it
        online for free (SuperFlyer shows you how) and share the link. A Tip Jar page lets readers
        support you. You can also export a print-ready PDF or page images for social media.
      </p>
      <img src={`${shots}/3.jpg`} alt="A SuperFlyer flip-book on three phone screens" class="shot inline" />
    </div>
  </section>

  <section class="feature-section fade-in alt">
    <div class="feature-icon">🌐</div>
    <div class="feature-body">
      <h2>Your comic in another language.</h2>
      <p>
        Translate Book makes a new edition with every balloon, caption and title translated into
        one of more than 20 languages, using Apple's translation on your Mac. Your original stays
        as it is.
      </p>
    </div>
  </section>

  <section class="feature-section fade-in">
    <div class="feature-icon">🔒</div>
    <div class="feature-body">
      <h2>Private by design.</h2>
      <p>
        No account, no analytics, no ads. Your comics stay on your Mac. Image Playground,
        translation, cut-outs and comic looks run on the Mac itself. Only if you add your own
        OpenRouter key do your prompts and pictures go to the AI service you choose.
        <a href="/privacy/superflyer">Privacy policy</a>
      </p>
    </div>
  </section>

  <AppFAQ items={[
    {
      question: "Is SuperFlyer really free?",
      answer: "Yes. Making, saving, exporting and sharing comics are free, with no account and no watermark beyond a small 'Made with SuperFlyer' line under flip-books. Image Playground drawings, comic looks, cut-outs and translation are free because they run on your Mac. OpenRouter image models are optional and are paid for with your own OpenRouter account."
    },
    {
      question: "Which Macs does it run on?",
      answer: "Macs with macOS 26 or later. Image Playground needs Apple Intelligence on an Apple silicon Mac; everything else works on any Mac that runs macOS 26."
    },
    {
      question: "How do I get my comic onto people's phones?",
      answer: "Export a flip-book. It's a folder (and a .zip) that works as a small website. Upload it to a free host such as Netlify Drop or Cloudflare Pages, or to your own site, and share the address. The export window has a step-by-step guide."
    },
    {
      question: "Can I use photos of people?",
      answer: "Use your own photos and pictures you have the right to use. For a character's reference picture, use a drawing, a photo of yourself, or an AI-made sheet, not photos of other real people without their permission."
    },
    {
      question: "Is it good for classrooms?",
      answer: "Yes. File ▸ New Classroom Comic starts a comic with all AI tools switched off. The Water Cycle example shows a step-by-step school project."
    }
  ]} />

</BaseLayout>

<style>
  .product-hero {
    text-align: center;
    padding: 4rem 0 3rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .product-icon {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    margin-bottom: 1.5rem;
  }

  .product-hero h1 {
    font-size: 2.75rem;
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--gray-dark);
    margin-bottom: 1.5rem;
  }

  .hero-meta {
    font-size: 0.9rem;
    color: var(--gray);
  }

  /* Feature sections */
  .feature-section {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
    max-width: 900px;
    margin: 0 auto;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--gray-light);
  }

  .feature-section.alt {
    background: var(--gray-light);
    padding: 3.5rem calc((100% - 900px) / 2 + 1.5rem);
    margin: 0 calc(-1 * (100vw - 900px) / 2);
    max-width: 100vw;
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    border-bottom: none;
    justify-content: center;
  }

  .feature-section.alt > .feature-icon,
  .feature-section.alt > .feature-body {
    max-width: 420px;
  }

  .feature-section.alt > .feature-body {
    max-width: 820px;
  }

  .feature-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
    width: 56px;
    text-align: center;
    padding-top: 0.25rem;
  }

  .feature-body {
    flex: 1;
    max-width: 820px;
  }

  .feature-body h2 {
    font-size: 1.6rem;
    margin-bottom: 1rem;
  }

  .feature-body p {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* Source grid */
  .source-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .source-card {
    background: #fff;
    border-radius: 10px;
    padding: 1rem 1.1rem 1.1rem;
  }

  .source-cat {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--blue);
    margin-bottom: 0.6rem;
  }

  .source-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .source-card ul li {
    font-size: 0.87rem;
    color: var(--gray-dark);
    line-height: 1.55;
    padding: 0.2rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .source-card ul li:last-child { border-bottom: none; }

  /* AI chips */
  .ai-chips {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }

  .chip {
    background: var(--blue);
    color: #fff;
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* Mini feature grid */
  .mini-feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .mini-feature {
    background: #fff;
    border-radius: 10px;
    padding: 1rem 1.25rem;
  }

  .mini-feature h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 0.4rem;
  }

  .mini-feature p {
    font-size: 0.9rem;
    margin: 0;
    color: var(--gray-dark);
  }

  /* Pricing */
  .pricing-section {
    max-width: 760px;
    margin: 0 auto;
    padding: 3.5rem 0;
    text-align: center;
    border-bottom: none;
  }

  .pricing-section h2 {
    font-size: 1.6rem;
    margin-bottom: 2rem;
  }

  .pricing-cards {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .pricing-card {
    flex: 1;
    max-width: 320px;
    background: var(--gray-light);
    border-radius: var(--radius);
    padding: 1.75rem;
    text-align: left;
  }

  .pricing-card.featured {
    background: var(--blue);
    color: #fff;
  }

  .pricing-card h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .pricing-card.featured h3 { color: rgba(255,255,255,0.8); }

  .price {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .price-detail {
    font-size: 0.8rem;
    opacity: 0.75;
    margin-bottom: 1rem;
    color: var(--gray-dark);
  }

  .pricing-card.featured .price-detail { color: rgba(255,255,255,0.7); }

  .pricing-card ul {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
  }

  .pricing-card ul li {
    font-size: 0.9rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    color: var(--gray-dark);
  }

  .pricing-card.featured ul li {
    border-color: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.9);
  }

  .pricing-card ul li::before { content: "✓  "; }

  /* Waitlist */
  .waitlist-section {
    padding: 1rem 0 3rem;
    border-bottom: none;
  }

  .privacy-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--gray);
    margin-top: -1.5rem;
  }

  .privacy-note a {
    color: var(--gray-dark);
    text-decoration: underline;
  }

  .privacy-note a:hover { color: var(--blue); }

  @media (max-width: 768px) {
    .feature-section,
    .feature-section.alt {
      flex-direction: column;
      gap: 1.25rem;
      padding: 2.5rem 1rem;
      margin-left: 0;
      margin-right: 0;
      width: 100%;
      left: 0;
      right: 0;
    }

    .source-grid {
      grid-template-columns: 1fr;
    }

    .mini-feature-grid {
      grid-template-columns: 1fr;
    }

    .pricing-cards {
      flex-direction: column;
      align-items: stretch;
    }

    .pricing-card { max-width: 100%; }
  }

  .shot-wrap { text-align: center; padding: 0 1rem 2.5rem; border-bottom: none; }
  .shot { width: 100%; max-width: 980px; border-radius: 14px; box-shadow: 0 18px 50px rgba(0,0,0,0.25); }
  .shot.inline { margin: 1rem 0; }
  .example-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 1.25rem; }
  .example { display: flex; flex-direction: column; gap: 0.35rem; text-decoration: none; color: inherit; }
  .example img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.2); transition: transform 0.15s; }
  .example:hover img { transform: translateY(-3px); }
  .example strong { font-size: 0.95rem; color: var(--blue); }
  .example span { font-size: 0.85rem; color: var(--gray-dark); }
  @media (max-width: 768px) { .example-grid { grid-template-columns: 1fr; } }
</style>
