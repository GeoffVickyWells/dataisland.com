---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getPosts, topics, guides, productInfo } from "../../lib/blog";

const posts = await getPosts();
// A post marked featured leads the page; otherwise the newest one does.
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== lead);
const usedTopics = Object.keys(topics).filter((t) => posts.some((p) => p.data.topics.includes(t)));
---

<BaseLayout
  title="Blog — DataIsland Software"
  description="Writing, multilingual, cooking and Mac how-tos and essays from DataIsland Software, the makers of FusionMD, PolyWrite, KitchenCalc and Network Notes."
>
  <div class="blog">
    <header class="masthead">
      <p class="eyebrow">The DataIsland Blog</p>
      <h1>Notes from the island.</h1>
      <p class="deck">
        How-tos for writing, languages, cooking and getting more out of your Mac,
        plus essays on how we think software should work.
      </p>
      <nav class="topics" aria-label="Topics">
        <a href="/blog" class="chip active">All posts</a>
        {usedTopics.map((t) => (
          <a href={`/blog/topic/${t}`} class="chip" style={`--ink:${topics[t].ink};--tint:${topics[t].tint}`}>
            {topics[t].label}
          </a>
        ))}
        <a href="/rss.xml" class="chip rss" title="Follow the blog in any RSS reader">RSS</a>
      </nav>
    </header>

    {lead && (
      <section class="lead">
        <BlogCard post={lead} featured />
      </section>
    )}

    {rest.length > 0 && (
      <section class="grid-section">
        <h2 class="section-title">More posts</h2>
        <div class="grid">
          {rest.map((post) => <BlogCard post={post} />)}
        </div>
      </section>
    )}

    <section class="guides">
      <h2 class="section-title">Long-form guides</h2>
      <div class="guide-list">
        {guides.map((g) => {
          const app = productInfo(g.app);
          return (
            <a href={g.href} class="guide">
              {app && <img src={app.icon} alt="" />}
              <span>
                <strong>{g.title}</strong>
                <small>{g.blurb}</small>
              </span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .blog { max-width: 1100px; margin: 0 auto; }
  .blog section { border-bottom: none; padding: 0; }

  .masthead {
    text-align: center;
    padding: 2.5rem 0 2.5rem;
    max-width: 720px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.5rem;
  }
  .masthead h1 {
    font-family: "New York", "Iowan Old Style", Georgia, serif;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .deck { font-size: 1.1rem; line-height: 1.65; margin-bottom: 1.75rem; }

  .topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .chip {
    --ink: var(--gray-dark);
    --tint: var(--gray-light);
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    background: var(--tint);
    color: var(--ink);
  }
  .chip.active { background: #1a1a1a; color: #fff; }
  .chip.rss { background: transparent; border: 1px solid #ddd; color: var(--gray); }

  .lead {
    padding: 2rem 0 3.5rem !important;
    border-top: 1px solid #eee;
  }

  .section-title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #eee;
    margin-bottom: 1.75rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 2.5rem 2rem;
    margin-bottom: 4rem;
  }

  .guides { margin-bottom: 2rem; }
  .guide-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1rem;
  }
  .guide {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    background: var(--sand);
    border-radius: var(--radius);
    color: inherit;
  }
  .guide:hover { opacity: 1; background: #f0eadb; }
  .guide img { width: 44px; height: 44px; border-radius: 10px; flex-shrink: 0; }
  .guide strong { display: block; font-size: 0.98rem; line-height: 1.3; }
  .guide small { display: block; font-size: 0.83rem; color: var(--gray-dark); line-height: 1.45; margin-top: 0.2rem; }
  .arrow { margin-left: auto; color: var(--blue); font-weight: 700; }
</style>
